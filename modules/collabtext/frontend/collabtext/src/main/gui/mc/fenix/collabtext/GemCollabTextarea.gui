package mc.fenix.collabtext;

import CollabTextModule.CollabText;
import CollabTextModule.CollabTextCursor;

/** Text area that reads and changes the collaborative text data directly. */
component GemCollabTextarea(
  CollabText text,
  /** Cursor of the current user. Selection changes update its attributes directly. */
  CollabTextCursor cursor,
  /** Visuals for the other users' cursors and selections. */
  List<GUIViewElement> cursors,
  String placeholder = "",
  boolean disabled = false,
  boolean showChunks = false,
  String width = "100%",
  String height = "100%"
)
