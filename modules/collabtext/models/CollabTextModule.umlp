import java.util.List;

umlp CollabTextModule {

  // A plain text that several users edit at the same time.
  class CollabText {
    // The text is the content of the chunks in this order. An edit only changes the chunks it
    // touches, so the text is neither stored nor sent as a whole when a user types.
    List<CollabTextChunk> chunks;
    // The most recently applied edit as
    // "<revision>|<gemId of the author's cursor>|<length of the text after the edit>|<TextEdit>".
    // The backend sets it after the chunks, so every client sees all edits in the same order.
    String lastEdit = "";
    List<CollabTextCursor> cursors;
  }

  class CollabTextChunk {
    String content;
  }

  // Cursor or selection of one user who has the text open.
  class CollabTextCursor {
    String userName;
    String color;
    // Indices into the text. The selection starts at the anchor and ends at the head, where the cursor is.
    int anchor = 0;
    int head = 0;
    // Websocket participant of the user, the backend removes the cursor when it has disconnected.
    long participant;
  }

  <<singleton>>
  class CollabTextService {
    // `edit` was made on the text after `baseRevision` edits. The backend adapts it to the
    // edits of other users applied since then.
    void applyEdit(CollabText text, CollabTextCursor author, int baseRevision, String edit);
  }

}
