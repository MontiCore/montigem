{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@montigem/login": [
        "./login"
      ],
      "@umlp/arrange": ["../../../umlp-rte/frontend/build/dist/arrange"],
      "@umlp/basic": ["../../../umlp-rte/frontend/build/dist/basic"],
      "@umlp/charts": ["../../../umlp-rte/frontend/build/dist/charts"],
      "@umlp/common": ["../../../umlp-rte/frontend/build/dist/common"],
      "@umlp/commonj2ts": ["../../../umlp-rte/frontend/build/dist/commonj2ts"],
      "@umlp/input": ["../../../umlp-rte/frontend/build/dist/input"],
      "@umlp/navigation": ["../../../umlp-rte/frontend/build/dist/navigation"],
      "@umlp/table": ["../../../umlp-rte/frontend/build/dist/table"],
      "@umlp/networkgraph": ["../../../umlp-rte/frontend/build/dist/networkgraph"]
    },
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitOverride": false,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "noUnusedLocals": false,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "exclude": [
    "**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
