package packaged;

umlp QualifiedDomain {
  class Directory;

  class Member {
    String login;
    int number;
  }

  class Office {
    int room;
  }

  association Directory [[login]] (loginDirectory) -> (byLogin) Member [1];
  association Directory [[number]] (numberDirectory) -> (byNumber) Member [1];
  association Directory -> (office) Office [1];
  // type qualified: the key is chosen on put
  association Directory [String] (codeDirectory) -> (byCode) Member [1];
}
