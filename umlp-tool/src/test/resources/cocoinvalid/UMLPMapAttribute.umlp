umlp UMLPMapAttribute {
  class A {
    // invalid value types (0xCDC6E): neither a domain class nor a simple type
    java.util.Map<String, java.util.List<B>> lists;
    java.util.Map<String, java.util.Map<String, Integer>> maps;
    // invalid key types (0xCDC6F): the keys of type qualified associations, domain class keys only for domain class
    // values
    java.util.Map<Double, B> byWeight;
    java.util.Map<Boolean, B> byFlag;
    java.util.Map<E, B> byKind;
    java.util.Map<Double, Integer> countByWeight;
    java.util.Map<C, Integer> countByC;
    java.util.Map<Boolean, Integer> countByFlag;
    java.util.Map<E, Integer> countByKind;
    // valid
    java.util.Map<String, B> byName;
    java.util.Map<Long, B> byPhone;
    java.util.Map<C, B> byC;
    java.util.Map<String, Integer> counts;
    java.util.Map<String, E> kinds;
    java.util.Map<java.time.LocalDate, Integer> countByDay;
    // invalid value types (0xCDC6E): a char, a number in Java but a string in the browser
    java.util.Map<String, Character> initials;
    java.util.Map<String, char> letters;
  }

  class B;

  class C;

  enum E;
}
