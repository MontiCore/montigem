umlp UMLPAttributeTypeIsNotJavaUtilSet {

  class A {
    java.util.Set<Integer> a;
  }

  class B {
    boolean isTrue;
  }

  association [*] A -> B [0..1];
  association [1] B -> A;
  association A [String] -> B [*];
  association B [[a]] -> A [1];
}
