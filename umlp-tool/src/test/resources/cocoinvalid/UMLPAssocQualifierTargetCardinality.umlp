/* (c) https://github.com/MontiCore/monticore */
umlp UMLPAssocQualifierTargetCardinality {
  class A {
    String name;
  }
  class B;

  // A GemMap holds exactly one value per key: a [*] or [1..*] value side would need a GemList per key, a [0..1] or
  // unspecified one an Optional, and neither is GemIdentifiable, which a GemMap value has to be.
  association B [[name]] (byNameMany) -> A [*];
  association B [[name]] (byNameOpt) -> A [0..1];
  association B [[name]] (byNameSome) -> A [1..*];
  association B [[name]] (byNameNone) -> A;
  association [*] A (byNameFromRight) <- [[name]] B;
  association B [String] (byStringMany) -> A [*];
  association B [B] (byBOpt) -> A [0..1];
  association [*] A (byIntFromRight) <- [int] B;

  // valid: the value side is [1], the qualifier side may have any cardinality
  association B [[name]] (byName) -> A [1];
  association [*] B [[name]] (byNameManyOwners) -> A [1];
  association B [String] (byString) -> A [1];
  association [*] B [B] (byBManyOwners) -> A [1];
}
