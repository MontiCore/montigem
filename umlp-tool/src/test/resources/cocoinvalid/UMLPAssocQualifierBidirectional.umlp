umlp UMLPAssocQualifierBidirectional {
  class A {
    String name;
  }

  class B {
    int number;
  }

  association B [[name]] -> A [*];
  association B [[name]] <-> A [*];
  association B [[name]] <- A [*];
  association [*] B <-> [[number]] A;
}
