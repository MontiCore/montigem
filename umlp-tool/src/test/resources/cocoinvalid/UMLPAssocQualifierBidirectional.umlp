umlp UMLPAssocQualifierBidirectional {
  class A {
    String name;
  }

  class B {
    int number;
  }

  association B [[name]] -> A [1];
  association B [[name]] <-> A [1];
  association B [[name]] <- A [1];
  association [1] B <-> [[number]] A;
}
