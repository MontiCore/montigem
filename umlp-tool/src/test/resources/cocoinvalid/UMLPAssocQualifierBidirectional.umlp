/* (c) https://github.com/MontiCore/monticore */
umlp UMLPAssocQualifierBidirectional {
  class A {
    String name;
  }

  class B {
    int number;
  }

  association B [[name]] -> A [1];
  association B [[name]] <-> A [1];
  association B [[name]] <- A [1];
  association [1] B <-> [[number]] A;
  association B [String] (byName) -> A [1];
  association B [String] (byNameBoth) <-> A [1];
  association B [A] (byA) <- A [1];
  association [1] B <-> [int] A;
  association [1..*] B [[name]] (someB) <-> (byNameSome) A [1];

  // valid: bidirectional with the cardinality of the qualified class
  association [1] B [[name]] (oneB) <-> (byNameOne) A [1];
  association [0..1] B [String] (optB) <-> (byNameOpt) A [1];
  association [*] B [A] (manyB) <-> (byAMany) A [1];
}
