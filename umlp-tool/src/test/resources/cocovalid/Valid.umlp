umlp Valid {

  class A {
    int a;
    java.util.List<String> names;
  }

  class B {
    boolean isTrue;
    /String derivedAttr;
  }

  class C extends B {
    /String derivedAttr;
    String otherAttr;
  }

  interface I;

  enum E;

  association [*] A -> B [0..1];
  association [1] B (a1) -> (b1) A;
  association A [String] (b2) -> (a2) B [*];
  association B [[a]] (a3) -> (b3) A [1];
  association B -> String;
}
