umlp UMLPAssocQualifierKeys {
  class A {
    String name;
    int number;
    boolean flag;
    C c;
  }

  class B;

  class C;

  class D;

  // a key via an association role instead of an attribute
  association A -> (d) D [1];
  association B [[d]] (byD) -> A [*];

  association B [[name]] (byName) -> A [*];
  association B [[number]] (byNumber) -> A [0..1];
  association B [[flag]] (byFlag) -> A [*];
  association B [[c]] (byC) -> A [*];

  // the qualifier on the right side, navigable from right to left
  association [*] A (byNameFromRight) <- [[name]] B;
}
