umlp UMLPAssocQualifierKeys {
  class A {
    String name;
    int number;
    boolean flag;
    C c;
  }

  class B;

  class C;

  class D;

  // a key via an association role instead of an attribute
  association A -> (d) D [1];
  association B [[d]] (byD) -> A [1];

  association B [[name]] (byName) -> A [1];
  association B [[number]] (byNumber) -> A [1];
  association B [[flag]] (byFlag) -> A [1];
  association B [[c]] (byC) -> A [1];

  // the qualifier on the right side, navigable from right to left
  association [1] A (byNameFromRight) <- [[name]] B;

  // type qualified: the key is chosen on put
  association B [String] (byString) -> A [1];
  association B [int] (byInt) -> A [1];
  association B [C] (byCKey) -> A [1];
  association [1] A (byLongFromRight) <- [long] B;
}
