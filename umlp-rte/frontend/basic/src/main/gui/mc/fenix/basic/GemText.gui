/* (c) https://github.com/MontiCore/monticore */
package mc.fenix.basic;

/**
  Displays text on a webpage.
*/
component GemText(
  /** Text content. */
  String value,
  /** Text color in `hex`, `rgb`, color names, etc. (e.g. `#000000`, `red`) */
  String color,
  /** Font size in `px`, `%`, `em`, etc. */
  String size,
  /**
    Font style. Can be `"normal"`, `"italic"`, `"oblique <deg>"`, or have a universal value
  */
  String fontStyle = "unset",
  /**
    Font weight. Can be `"normal"`, `"bold"`, `"lighter"`, `"<number>"`, or have a universal value
  */
  String weight = "unset",
  /** Font family. Example: `"Gill Sans", sans-serif` */
  String fontFamily = "unset",
  /** Width of the text in `px`, `%`, `em`, etc. By default as wide as its content or the layout allows. */
  String width = "auto",
  /** Height of the text in `px`, `%`, `em`, etc. By default as high as its content. */
  String height = "auto"
)
