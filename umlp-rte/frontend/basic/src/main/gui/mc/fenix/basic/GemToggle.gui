package mc.fenix.basic;

/**
  Toggle switch that lets the user turn a binary option on or off with a
  single click.
*/
component GemToggle(
  /** Current state of the toggle. `true` means switched on. */
  boolean state = false,
  /** Color of the toggle track when it is switched on. */
  String color = "#2563eb",
  /** Color of the toggle track when it is switched off. */
  String inactiveColor = "#9ca3af",
  /**
    Text shown next to the toggle. Also used as the name screen readers
    announce for the toggle. If empty, no label is shown.
  */
  String label = "",
  /** If true, the toggle cannot be switched. */
  boolean disabled = false,
  /** Width of the toggle track in `px`, `%`, `vh`. */
  String width = "44px",
  /** Height of the toggle track in `px`, `%`, `vh`. */
  String height = "24px",
  /** Callback that is executed when the toggle is switched. Receives the new state. */
  Event<boolean> toggled
)
