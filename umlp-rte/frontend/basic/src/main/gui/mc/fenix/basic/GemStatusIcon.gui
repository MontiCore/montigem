package mc.fenix.basic;

/**
  Displays an icon whose color (and optionally symbol) depends on a status value,
  e.g. the value of an enum. A typical use is a traffic light style indicator
  that is green, yellow or red depending on the state of an object.

  The `status` is looked up (case-insensitive) in `states`. The color and icon at
  the same position in `colors` and `icons` are used for the display. If `states`
  is not set, the default states `OK`, `WARNING` and `ERROR` are mapped to the
  theme's success, warning and error colors.
*/
component GemStatusIcon(
  /** Current status to display, e.g. the name of an enum constant. */
  String status,
  /** Possible status values, in the same order as `colors` and `icons`. */
  List<String> states,
  /** Colors corresponding to each state in `hex`, `rgb`, color names, etc. */
  List<String> colors,
  /** Optional icon names corresponding to each state; if unset, `icon` is used for every state. */
  List<String> icons,
  /** Icon used for all states without an own icon, corresponding to the icon name from https://fonts.google.com/icons. */
  String icon = "circle",
  /** Color used if the status does not match any of the `states`. */
  String defaultColor = "gray",
  /** Size of the icon in `px`, `%`, `em`, etc. */
  String size = "24px",
  /** If true, the status text is displayed next to the icon. */
  boolean showLabel = false
)
