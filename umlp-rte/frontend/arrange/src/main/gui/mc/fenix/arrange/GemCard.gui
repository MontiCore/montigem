package mc.fenix.arrange;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

/**
  Card is a container with a header and a body. Both header and body may contain
  any elements, such as button, inputs, charts, etc.
*/
component GemCard(
  /**
    Height of the component in `px`, `%`, `vh`. By default collapses to a
    minimal possible height with respect to content.
  */
  String height = "auto",
  /**
    Width of the component in `px`, `%`, `vh`. By default collapses to a
    minimal possible width with respect to content.
  */
  String width = "auto",
  /** Text displayed at the top of the card. */
  String title = "",
  /**
    A component displayed at the top of the card. If `titleComponent` and
    `title` are both set, the `titleComponent` will be used.
  */
  GUIViewElement titleComponent,
  /** Component displayed in body of the card. */
  GUIViewElement component,
  /**
    Whether the card can be collapsed/expanded.
  */
  boolean collapsible = false
) {
  @GemColumn(style = "mat-elevation-z8", height = "100%", components = [
    @GemRow(style = "gem-card-header"),
    @GemColumn(style = "gem-card-body", component = component)
  ]);
}
