package mc.fenix.navigation;

/**
  GemNavItem renders a single, clickable entry of a `GemNavList`, e.g. a link to
  another page of the application.
*/
component GemNavItem(
  /** Text displayed for the navigation entry. */
  String title,
  /** Route the navigation entry links to. */
  String target,
  String iconName = null,
  GUIViewElement component,
  /** Callback that is executed when the navigation entry is clicked. */
  Event<Void> leftClick
)
