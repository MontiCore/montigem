package mc.fenix.navigation;

/**
  GemNavList renders a vertical navigation list, e.g. for a sidebar menu. It arranges
  navigation entries such as `GemNavItem` between an optional header and footer.
*/
component GemNavList(
  /** Navigation entries displayed in the list, e.g. `GemNavItem` instances. */
  List<GUIViewElement> components,
  /** Optional element displayed above the list of entries. */
  GUIViewElement header = null,
  /** Optional element displayed below the list of entries. */
  GUIViewElement footer = null,

  /** Width of the list. */
  String width = "auto",
  /** Height of the list. */
  String height = "100%",
  /** Whether the list is collapsed to icon-only mode. */
  Boolean collapsed = false,
  /** Width of the list when collapsed. */
  String collapsedWidth = "4rem",
  /** Icon shown on the collapse toggle when the list is expanded. */
  String collapseIcon = "chevron_left",
  /** Icon shown on the collapse toggle when the list is collapsed. */
  String expandIcon = "chevron_right",
  /** Emitted when the collapsed state changes. */
  Event<Void> collapsedChange
)
