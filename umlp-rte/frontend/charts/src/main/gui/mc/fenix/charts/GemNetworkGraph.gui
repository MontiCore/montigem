package mc.fenix.charts;

import mc.fenix.charts.GemNetworkGraphTypes.GemNetworkData;

/**
  GemNetworkGraph is a graphical representation of a network. It is composed of
  nodes and edges. Nodes are the entities of the network, and edges are the
  relationships between the nodes.

  For example, it can be used to visualize a social network of friends, or the
  dependencies between software modules in a project.
*/
component GemNetworkGraph(
  /** The graph data (nodes and edges) to be displayed. */
  GemNetworkData data,
  /** Whether an improved, force-directed layout algorithm is used to arrange the nodes. */
  boolean improvedLayout = true,
  /** Whether the chart's configuration panel is shown. */
  boolean showConfig = false
)
