package mc.fenix.charts;

import mc.fenix.charts.GemGaugeChartTypes.GemGaugeChartData;

/**
  Gauge charts are also known as dial charts or speedometer charts. Normally they consist of a dial and a pointer, use the pointer to read the information. There are several different types of gauge charts,
  such as Speedometer, Linear Gauge Charts and Angular Gauge Charts.
  Gauge charts are very helpful to visualize and compare single data value with a quantitative context.

  For example, it can be used to display the current CPU usage of a server, or
  the fill level of a tank as a percentage of its capacity.
*/
component GemGaugeChart (
  /**
    The data to be displayed in the chart.
  */
  GemGaugeChartData data,
  /**
    The minimum value of the scale.
  */
  Integer min,
  /**
    The maximum value of the scale.
  */
  Integer max,
  /**
    The unit string displayed below the value (e.g. "km/h").
  */
  String unit,
  /**
    The text value to display (e.g. the current value or a label).
  */
  String textValue,
  /**
    Position of the text value.
    Possible values: "center" (default), "top", "bottom".
  */
  String textPosition = "center"
)
