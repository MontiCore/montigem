// CD2Pojo only supports "classdiagram", not "umlp"
// TODO: import java.time.LocalDateTime;


<<pygem>>
classdiagram MyDomain { //b

  class A {
    String myStr = "hello";
    java.util.Optional<String> strOpt;
    java.util.List<String> strList;
    B directB;
    int i = 42;
    double d = 42.42;
    // boolean bool = false; // TODO -> report error
    boolean myBool = true;
    // TODO: LocalDateTime localDateTimeTest;

    // HW: executable: typing.Optional[typing.Any] = None

    MyEnum enumState = MyEnum.A;
  }

  class B {}
  association A -> B;

  class TestAssoc_1_A {}
  class TestAssoc_1_B {}
  association TestAssoc_1_A -> TestAssoc_1_B;
  association TestAssoc_1_A -> (singleB) TestAssoc_1_B;
  association TestAssoc_1_A -> (optB) TestAssoc_1_B [0..1];
  association TestAssoc_1_A -> (listB) TestAssoc_1_B [*];

  // Note: bidirectional builders are not possible with 2+ mandatory assocs between classes
  class TestAssoc_2_A {}
  class TestAssoc_2_B {}
  class TestAssoc_2_C {}
  class TestAssoc_2_D {}
  class TestAssoc_2_E {}
  class TestAssoc_2_F {}
  // TODO: bidirectional mandatory assocs are just plainly broken?
  //association TestAssoc_2_A               <-> TestAssoc_2_B;
  //association TestAssoc_2_A (singleA)     <-> (single) TestAssoc_2_C; //TODO: =>recursive loop
  association [0..1] TestAssoc_2_A (singleA)<-> (single) TestAssoc_2_C; // note, the back reference is opt!
  association [0..1] TestAssoc_2_A (optA) <-> (opt) TestAssoc_2_D [0..1];
  association [*] TestAssoc_2_A (listA)   <-> (listE) TestAssoc_2_E [*];
  association [0..1] TestAssoc_2_A (optA )<-> (listF) TestAssoc_2_F [*];



  <<singleton>>
  class SingletonManager {
    void voidCommand();
    void voidCommand2(A a);
    void voidCommand3(A a, int i);

    B createB();
  }

  class Ext1 {}
  class Ext2 extends Ext1 {}

  enum MyEnum {
    A, B, C;
  }

  class SuperClass {}
  class ChildClass extends SuperClass {}
}
