{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": ".",
    "outDir": "./out",
    "paths": {
      "@umlp/commonj2ts": ["./commonj2ts-facade/index.ts"],
      "@umlp/functiondisplay": ["./functiondisplay-facade/index.ts"],
      "@js-temporal/polyfill": ["./node_modules/@js-temporal/polyfill/index.d.cts"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["*.ts"]
}
