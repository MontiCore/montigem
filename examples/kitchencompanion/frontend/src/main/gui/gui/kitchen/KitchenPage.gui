package gui.kitchen;

import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import gui.kitchen.UserPanel;
import gui.navigation.NavContainer;
import mc.fenix.navigation.GemNavItem;
import KitchenCompanion.User;
import KitchenCompanion.KitchenCompanionRole;
import gui.management.AlphabetSearch;
import gui.base.Footer;
import gui.base.PageLayout;
import gui.base.Header;

page KitchenPage(List<User> users, String searchLetter = "") {
  @PageLayout(topContent = [
      header@Header(headline = "Kitchen Companion", timerNeeded = false, backBtnNeeded = false),
      @AlphabetSearch(selectedLetter = searchLetter, userOrOffer = true, onSelect = selectLetter())
    ],
    scrollableContent = [
      leadPanel@UserPanel(allUsers = users, searchLetter = searchLetter, adminPage = false, role = KitchenCompanionRole.VIP),
      ordinaryPanel@UserPanel(allUsers = users, searchLetter = searchLetter, adminPage = false, role = KitchenCompanionRole.USER),
      extraPanel@UserPanel(allUsers = users, searchLetter = searchLetter, adminPage = false, role = KitchenCompanionRole.EXTRA),
      hiwiPanel@UserPanel(allUsers = users, searchLetter = searchLetter, adminPage = false, role = KitchenCompanionRole.HIWI)
    ],
    footer = @Footer(
      title = "ADMIN PAGE",
      target = "/gui/admin/Admin"
    )
  );
}
