package gui.kitchen;

import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;

import KitchenCompanion.User;
import KitchenCompanion.KitchenCompanionRole;

component UserPanel(List<User> allUsers, String searchLetter, boolean adminPage, KitchenCompanionRole role){
  @GemRow(hAlign = "center", colGap = "1rem", rowGap = "1rem", wrap = "wrap", components = [
    @iterate(User user : allUsers){
      @guard(search(searchLetter, user, role)) {
        @GemButton(
          label = user.formattedName,
          width = "20rem",
          margin = "0",
          leftClick = navigateToUser(user, adminPage)
        );
      }
    }
  ]);
}
