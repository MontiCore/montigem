package gui.admin;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemTextInput;
import mc.fenix.input.GemTextareaInput;
import mc.fenix.navigation.GemNavItem;
import gui.base.Footer;
import gui.admin.create.CreateUser;

page Admin() {
  adminColumn@GemColumn(hAlign = "center",width = "auto", components = [
    managementText@GemText(value = "Data Management"),
    dataRow@GemRow(colGap="1rem", rowGap="1rem", wrap = "wrap", components = [
      @GemButton(label = "Receipts", leftClick = navigate(@PaymentStatus())),
      @GemButton(label = "Edit current Users", leftClick = navigate(@UserPage())),
      @GemButton(label = "Create new User", leftClick = navigate(@CreateUser())),
      @GemButton(label = "Offer Administration", leftClick = navigate(@OfferAdmin()))
    ]),
    endOfMonth@GemText(value = "End of Month"),
    monthRow@GemRow(colGap="1rem", rowGap="1rem", wrap = "wrap", components = [
      @GemButton(label="SendMail",leftClick = sendMail()),
      @GemButton(label = "EndMonth", leftClick = endMonth())
    ])
  ]);
  @Footer(
    title = "Home Page",
    target = "/gui/kitchen/KitchenPage"
  );
}
