package gui.admin;
import mc.fenix.arrange.GemColumn;
import gui.kitchen.UserPanel;
import KitchenCompanion.User;
import KitchenCompanion.KitchenCompanionRole;

import gui.management.AlphabetSearch;

page UserPage(List<User> userList, String searchLetter = "") {
    @GemColumn(hAlign = "center", vAlign = "center", rowGap="1rem",
      components = [
        @AlphabetSearch(selectedLetter = searchLetter, userOrOffer = true, onSelect = selectLetter()),
        leadPanel@UserPanel(allUsers = userList, searchLetter = searchLetter, adminPage = true, role = KitchenCompanionRole.VIP),
        ordinaryPanel@UserPanel(allUsers = userList, searchLetter = searchLetter, adminPage = true, role = KitchenCompanionRole.USER),
        extraPanel@UserPanel(allUsers = userList, searchLetter = searchLetter, adminPage = true, role = KitchenCompanionRole.EXTRA),
        hiwiPanel@UserPanel(allUsers = userList, searchLetter = searchLetter, adminPage = true, role = KitchenCompanionRole.HIWI)
    ]);
}
