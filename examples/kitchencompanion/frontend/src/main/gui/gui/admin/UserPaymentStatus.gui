package gui.admin;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemButton;
import mc.fenix.input.GemCheckBoxInput;
import mc.fenix.arrange.GemColumn;
import KitchenCompanion.Receipt;
import KitchenCompanion.User;
import mc.fenix.arrange.GemRow;
component UserPaymentStatus(User user, Receipt receipt){
  @GemCard(
    title = user.name + " " + user.lastName,
    component = @GemColumn(components = [
      @GemText(
        value = getInvoiceAmount(receipt)
      ),
      paid@GemCheckBoxInput(
        labelText = "hat bezahlt",
        checked = receipt.paid,
        disabled = receipt.confirmed
      ),
      @guard(receipt.paid){
        amountPaid@GemTextInput(
          inputType = "number",
          disabled = receipt.confirmed,
          entry = receipt.amountPaid
        );
        @GemRow(components = [
          @GemButton(label = "confirm", leftClick = confirm()),
          @GemButton(label = "reset", leftClick = reset())
        ]);
      }
    ])
  );
}
