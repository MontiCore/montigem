package gui.management;

import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;

component AlphabetSearch(String selectedLetter, boolean userOrOffer, Event<String> onSelect){
  @GemRow(hAlign = "center", wrap="wrap", components = [
    clear@GemButton(
      label = "Clear",
      leftClick = clearSelection(),
      disabled = isDisabled()
    ),
    @iterate(String str: getAlphabet()){
      alphabetButton@GemButton(
        label = str,
        leftClick = select(str),
        disabled = getDisabled(str)
      );
    }
  ]);
}
