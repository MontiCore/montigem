package gui.management;

import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemIcon;
import mc.fenix.basic.GemImage;
import mc.fenix.navigation.GemNavItem;

import gui.management.OfferOverview;
import gui.navigation.NavContainer;
import gui.components.Divider;
import KitchenCompanion.Offer;
import KitchenCompanion.User;
import gui.base.Header;
import gui.base.Footer;
import gui.base.PageLayout;

page OfferOverview(User user, List<Offer> offers, String searchLetter = "") {
  @PageLayout(
    topContent = [
      @Header(headline = user.formattedName, timerNeeded = true, backBtnNeeded = true),
      @AlphabetSearch(selectedLetter = searchLetter, userOrOffer = false, onSelect = selectLetter())
    ],
    scrollableContent = [
      row@GemRow(hAlign = "center",vAlign = "start", colGap="1rem", rowGap="1rem", wrap="wrap", components = [
        @iterate(Offer offer : getOfferList(user)){
          @guard(search(offer)){
            @OfferCard(offer = offer, user = user, count = getTallyCount(offer));
          }
        }
      ])],
      footer = @Footer(
        title = "Subtotal",
        target = getTargetAddress(user)
      )
  );
}
