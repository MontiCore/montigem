package gui.management;

import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemIcon;
import mc.fenix.basic.GemImage;
import mc.fenix.navigation.GemNavItem;

import gui.management.OfferOverview;
import gui.navigation.NavContainer;
import gui.components.Divider;
import KitchenCompanion.Offer;
import KitchenCompanion.User;
import gui.base.Header;
import gui.base.Footer;
import gui.base.PageLayout;


component OfferCard(Offer offer, User user, String count, boolean adminRights = false, boolean canRemoveTally){
  tallyColumn@GemColumn(width = "auto", hAlign = "center", rowGap = "0.5rem", components = [
    offerBtn@GemButton(
      width = "100%",
      margin = "0",
      content = [
        @GemCard(
          width = "100%",
          title = offer.name + ": " + offer.price + "€",
          component =
          @GemColumn(hAlign = "center",
            components = [
              offerImage@GemImage(
                height = "auto",
                source = offer.imgSource
                )
            ])
          )
      ],
      leftClick = addTally(offer)
    ),
    @GemRow(width = "auto", vAlign = "center", colGap = "0.5rem",
      components = [
        minusBtn@GemButton(
          content = [
            minusIcon@GemIcon(
              name = "remove_circle_outline"
            )
          ],
          leftClick = removeTally(offer),
          disabled = !canRemoveTally
        ),
        tallyCount@GemText(
          width = "auto",
          size = "1rem",
          value = count
        ),
        plusBtn@GemButton(
          leftClick = addTally(offer),
          content = [
            plusIcon@GemIcon(
              name = "add_circle"
            )
          ]
        )
      ]
    )
  ]);
}
