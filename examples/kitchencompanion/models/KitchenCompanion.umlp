import mc.fenix.input.GemTextInputTypes.GemTextInputValidity;
import java.util.*;
import java.time.LocalDate;

umlp KitchenCompanion {

  class User {
    String name;
    String lastName;
    <<dbColumn = "unique = true">> String nickname;
    double balance;
    <<dbColumn ="unique = true">> String email;
    KitchenCompanionRole role;
    / double sum;
    // "Lastname, Firstname" for display; implemented in the handwritten User class
    / String formattedName;
    List<Tally> tallies;
    List<Tally> prevTallies;
    List<Receipt> receipts;
  }

  enum KitchenCompanionRole {
    USER,
    HIWI,
    VIP,
    EXTRA,
    ADMIN;
  }

  enum ProductType{
    DRINK,
    SNACK;
  }

  class Offer {
    String imgSource;
    String name;
    double price;
    boolean inStock;
    ProductType productType;
  }

  class Tally {
    Offer offer;
    int count;
  }

  class Receipt {
    LocalDate date;
    List<Tally>pastTallies;
    boolean confirmed;
    double sum;
    double pastBalance;
    double debt;
    double amountPaid;
    boolean paid;
  }

  <<singleton>>
  class EmailSendingService {
    void sendEmail();
  }

  <<singleton>>
  class AdminLoginService {
    boolean checkAdminPassword(String password);
    boolean isDevEnvironment();
  }

}
