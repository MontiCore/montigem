package gui;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemImage;

import gui.Navigation;

page PageNotFound() {
  @Navigation();

  @GemColumn(hAlign = "center", rowGap = "20px", components = [
    @GemRow(width = "200px", component = @GemImage(source = "assets/images/Eule.png")),
    @GemCard(title = "SE Hub | 404", component =
      @GemColumn(width = "800px", hAlign = "center", components = [
        @GemText(value = "Oh no something went wrong - please fix it!")
      ])
    )
  ]);
}
