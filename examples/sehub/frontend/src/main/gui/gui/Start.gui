package gui;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;

import gui.Navigation;

page Start() {
  @Navigation();

  @GemColumn(width = "100%", hAlign = "center", component =
    @GemCard(title = "SE Hub | Welcome", component =
      @GemColumn(width = "50vw", rowGap = "10px", components = [
        @GemText(value =
          "This platform, developed using the MontiCore language workbench in a model-driven approach, " +
          "serves as a technical demonstration as well as a dedicated space for queries related to the " +
          "upcoming presentations at the FoWo Science Workshop. Here, questions regarding topics, " +
          "methodologies, and innovations to be discussed find their space, epitomizing the blend of " +
          "state-of-the-art technology with the unyielding spirit of scientific exploration."),
        @GemText(value =
          "Users can browse through existing discussions, submit new questions, and find clarity amidst " +
          "the vast expanse of research. With every interaction, the true essence of research is showcased " +
          "- not just the understanding, but the perpetual pursuit of knowledge."),
        @GemText(value = "Begin the exploration and let the discoveries unfold.")
      ])
    )
  );
}
