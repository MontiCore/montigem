package gui.login;

import Sehub.User;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;

import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemTextInput;

component UserLogin(User loginUser) {
  @GemCard(title = "Login", component =
    @GemColumn(hAlign = "center", rowGap = "20px", components = [
      @GemTextInput(
        labelText = "Account",
        inputType = "text",
        entry = loginUser.username,
        validity = loginUser.validityUsername,
        keyRelease = loginOnEnter()
      ),
      @GemTextInput(
        labelText = "Password",
        inputType = "password",
        entry = loginUser.password,
        validity = loginUser.validityPassword,
        keyRelease = loginOnEnter()
      ),
      // @GemButton(label = "Cancel", leftClick = navigateBack()),
      @GemButton(label = "Sign in", leftClick = login()),
      error@GemText(value = "")
    ])
  );
}
