/* (c) https://github.com/MontiCore/monticore */

classdiagram Sehub {

  /* Role datastructure - will later be separated in a general
     and application specific part that are merged.
  */
  class User {
    <<dbColumn = "unique=true", key_attribute>>
    String username;
    <<hidden_in_overview>>
    String password;
    // TODO: <<invisible>> is a workaround, remove it once the cd2gui scatter-plot
    // template no longer emits .get() on non-Optional date attributes.
    <<invisible>>
    java.time.LocalDateTime registrationDate;
    <<dbColumn = "unique=true">>
    String email;
    SehubRole role;
    String validityUsername();
    String validityPassword();
    String validityRole();
    String validityEmail();
  }

  enum SehubRole {
    GUEST,
    REPORTER,
    DEVELOPER,
    MAINTAINER,
    OWNER;
  }

  /* Application datastructure */

  class Project {
    String git;
    <<key_attribute>>
    String name;
    String fullName;
  }

  association app [1] Project -> (users) User [*];
  association tickets [1] Project -> (issues) Issue [*];

  class Issue {
    <<key_attribute>>
    String title;
    String description;
    IssueState state;
  }

  association discussion [0..1] Issue <-> (posts) Post [*];

  enum IssueState {
    UNASSIGNED,
    IN_PROGRESS,
    DONE;
  }

  class Post {
    String text;
    <<key_attribute>>
    String title;
  }

  association auth [1] Post -> (author) User [1];
  association resp [0..1] Post (parent) <-> (responses) Post [*];


  // ABSTRACT!
  class Artifact { // TODO shellAPI does not work with abstract classes
    String simpleName;
    <<hidden_in_overview>>
    String nameExtension;
    <<hidden_in_overview>>
    String modified;
    <<key_attribute>>
    String name;
    <<hidden_in_overview>>
    String fullName;
    /String type;
  }

  class FileArtifact extends Artifact {}

  association refersTo [*] Artifact (referrer) -> (referred) Artifact [*];

  association produces [*] Artifact (producer) -> (produced) Artifact [*];

  association root [*] Artifact -> (root) Project [1];

  association artifactRepresentation [1] Project -> (rootArtifact) Directory [*]; // TODO Optional because of technical issue 1 <-> 1 cycles not allowed

  class Directory extends Artifact {}

  composition [0..1] Directory (containedBy) <-> (contains) Artifact [*];
}
