import java.time.LocalDateTime;

classdiagram Jsweettest {
  class A {
    String value;
  }

  class B {
    String value;
  }

  class D {
    String value;
  }

  class E {
    String value;
    A a;
  }

  association [1] A -> B [*];
  association [1] B -> D [*];

  <<singleton>> class TestDataManager {
    void resetTestData();
  }



  class C1 {
    String string;
    int int1;
    Integer int2;
    C2 c2Req;

    long hwGemId;
  }

  association C1 (asOpt) -> (c2opt) C2 [0..1];
  association C1 (asMult) -> (c2mult) C2 [*];

  class C2 {
    String string;
    int int1;
    Integer int2;
  }

  association C2 (asOpt) -> (c3opt) C3 [0..1];
  association C2 (asMult) -> (c3mult) C3 [*];

  class C3 {
    String string;
    int int1;
    Integer int2;
  }

  class N0;
  class N1;
  class N2 {
    String name;
  }

  association [1] N0 -> N1 [1];
  association [1] N1 -> N2 [*];

  class EnumTestClass;
  enum EnumTestEnum {
    A, B, C;
  }
  association [1] EnumTestClass -> EnumTestEnum [1];

  <<singleton>>
  class GlobalState {
    -> (state) State [0..1];
  }

  class State {
    String name;
  }

  class Types {
    LocalDateTime timestamp;
  }

  // optional values of text inputs, which are converted from the input string
  class ClearableInputs {
    Optional<java.time.LocalDate> birthday;
    Optional<LocalDateTime> appointment;
    Optional<Integer> amount;
    Optional<EnumTestEnum> letter;
  }

  // async propagation
  class AsyncSuper;
  /association AsyncSuper -> A [*];

  class AsyncSubNonAsync extends AsyncSuper;

  class AsyncSubAsync extends AsyncSuper; // In Java

  // interface generation
  class Reference;
  interface ISource;
  association [1] ISource -> Reference [*];

  class ReferenceImpl implements ISource;

  <<singleton>>
  class DropdownInIterateSingleton {
    List<Placeholder> placeholders;
  }

  class Placeholder {
    Optional<String> anAttribute;
  }
}
