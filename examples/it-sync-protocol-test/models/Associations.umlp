/* (c) https://github.com/MontiCore/monticore */

umlp Associations {
  class OptToOptLhs; class OptToOptRhs;
  class OptToOneLhs; class OptToOneRhs;
  class OptToManyLhs; class OptToManyRhs;
  class OptToSomeLhs; class OptToSomeRhs;
  class OneToOptLhs; class OneToOptRhs;
  // Not allowed: class OneToOneLhs; class OneToOneRhs;
  class OneToManyLhs; class OneToManyRhs;
  // Not allowed: class OneToSomeLhs; class OneToSomeRhs;
  class ManyToOptLhs; class ManyToOptRhs;
  class ManyToOneLhs; class ManyToOneRhs;
  class ManyToManyLhs; class ManyToManyRhs;
  class ManyToSomeLhs; class ManyToSomeRhs;
  class SomeToOptLhs; class SomeToOptRhs;
  // Not allowed: class SomeToOneLhs; class SomeToOneRhs;
  class SomeToManyLhs; class SomeToManyRhs;
  // Not allowed: class SomeToSomeLhs; class SomeToSomeRhs;

  association optToOpt [0..1] OptToOptLhs <-> OptToOptRhs [0..1];
  association optToOne [0..1] OptToOneLhs <-> OptToOneRhs [1] ;
  association optToMany [0..1] OptToManyLhs <-> OptToManyRhs [*];
  association optToSome [0..1] OptToSomeLhs <-> OptToSomeRhs [1..*];
  association oneToOpt [1] OneToOptLhs <-> OneToOptRhs [0..1];
  // Not allowed: association oneToOne [1] OneToOneLhs <-> OneToOneRhs [1];
  association oneToMany [1] OneToManyLhs <-> OneToManyRhs [*];
  // Not allowed: association oneToSome [1] OneToSomeLhs <-> OneToSomeRhs [1..*];
  association manyToOpt [*] ManyToOptLhs <-> ManyToOptRhs [0..1];
  association manyToOne [*] ManyToOneLhs <-> ManyToOneRhs [1];
  association manyToMany [*] ManyToManyLhs <-> ManyToManyRhs [*];
  association manyToSome [*] ManyToSomeLhs <-> ManyToSomeRhs [1..*];
  association someToOpt [1..*] SomeToOptLhs <-> SomeToOptRhs [0..1];
  // Not allowed: association someToOne [1..*] SomeToOneLhs <-> SomeToOneRhs [1];
  association someToMany [1..*] SomeToManyLhs <-> SomeToManyRhs [*];
  // Not allowed: association someToSome [1..*] SomeToSomeLhs <-> SomeToSomeRhs [1..*];

  class UniOptToOptLhs; class UniOptToOptRhs;
  class UniOptToOneLhs; class UniOptToOneRhs;
  class UniOptToManyLhs; class UniOptToManyRhs;
  class UniOptToSomeLhs; class UniOptToSomeRhs;
  class UniOneToOptLhs; class UniOneToOptRhs;
  // Not allowed: class UniOneToOneLhs; class UniOneToOneRhs;
  class UniOneToManyLhs; class UniOneToManyRhs;
  // Not allowed: class UniOneToSomeLhs; class UniOneToSomeRhs;
  class UniManyToOptLhs; class UniManyToOptRhs;
  class UniManyToOneLhs; class UniManyToOneRhs;
  class UniManyToManyLhs; class UniManyToManyRhs;
  class UniManyToSomeLhs; class UniManyToSomeRhs;
  class UniSomeToOptLhs; class UniSomeToOptRhs;
  // Not allowed: class UniSomeToOneLhs; class UniSomeToOneRhs;
  class UniSomeToManyLhs; class UniSomeToManyRhs;
  // Not allowed: class UniSomeToSomeLhs; class UniSomeToSomeRhs;

  association uniOptToOpt [0..1] UniOptToOptLhs -> UniOptToOptRhs [0..1];
  association uniOptToOne [0..1] UniOptToOneLhs -> UniOptToOneRhs [1];
  association uniOptToMany [0..1] UniOptToManyLhs -> UniOptToManyRhs [*];
  association uniOptToSome [0..1] UniOptToSomeLhs -> UniOptToSomeRhs [1..*];
  association uniOneToOpt [1] UniOneToOptLhs -> UniOneToOptRhs [0..1];
  // Not allowed: association uniOneToOne [1] UniOneToOneLhs -> UniOneToOneRhs [1];
  association uniOneToMany [1] UniOneToManyLhs -> UniOneToManyRhs [*];
  // Not allowed: association uniOneToSome [1] UniOneToSomeLhs -> UniOneToSomeRhs [1..*];
  association uniManyToOpt [*] UniManyToOptLhs -> UniManyToOptRhs [0..1];
  association uniManyToOne [*] UniManyToOneLhs -> UniManyToOneRhs [1];
  association uniManyToMany [*] UniManyToManyLhs -> UniManyToManyRhs [*];
  association uniManyToSome [*] UniManyToSomeLhs -> UniManyToSomeRhs [1..*];
  association uniSomeToOpt [1..*] UniSomeToOptLhs -> UniSomeToOptRhs [0..1];
  // Not allowed: association uniSomeToOne [1..*] UniSomeToOneLhs -> UniSomeToOneRhs [1];
  association uniSomeToMany [1..*] UniSomeToManyLhs -> UniSomeToManyRhs [*];
  // Not allowed: association uniSomeToSome [1..*] UniSomeToSomeLhs -> UniSomeToSomeRhs [1..*];

  // Attribute qualified associations (GemMaps), one per case, see GemMapSyncTestGenerator. Names: <Key><Value>.
  //   Key:   Str  String attribute key                  (GemValueMap)
  //          Num  int attribute key                     (GemValueMap)
  //          Obj  domain typed attribute key: MapKey   (GemEntryMap)
  //          Role to-one association role key -> MapKey (GemEntryMap)
  //   Value: Plain    the map holds <Case>Value, which declares the key
  //          Super    the map holds <Case>Value, the key is declared in its superclass <Case>Base
  //          Sub      the map holds <Case>Base (declares the key) and contains instances of its subclass <Case>Value
  //          Abstract the map holds the abstract <Case>Base (declares the key), values are <Case>Value instances
  //   The owner is <Case>Owner, the role byKey; the value side is [1]: a key stands for one value.

  class MapKey {
    String name;
  }

  // StrPlain
  class StrPlainOwner;
  class StrPlainValue {
    String key;
  }
  association strPlainMap StrPlainOwner [[key]] -> (byKey) StrPlainValue [1];

  // StrSuper
  class StrSuperOwner;
  class StrSuperBase {
    String key;
  }
  class StrSuperValue extends StrSuperBase;
  association strSuperMap StrSuperOwner [[key]] -> (byKey) StrSuperValue [1];

  // StrSub
  class StrSubOwner;
  class StrSubBase {
    String key;
  }
  class StrSubValue extends StrSubBase;
  association strSubMap StrSubOwner [[key]] -> (byKey) StrSubBase [1];

  // StrAbstract
  class StrAbstractOwner;
  abstract class StrAbstractBase {
    String key;
  }
  class StrAbstractValue extends StrAbstractBase;
  association strAbstractMap StrAbstractOwner [[key]] -> (byKey) StrAbstractBase [1];

  // NumPlain
  class NumPlainOwner;
  class NumPlainValue {
    int key;
  }
  association numPlainMap NumPlainOwner [[key]] -> (byKey) NumPlainValue [1];

  // NumSuper
  class NumSuperOwner;
  class NumSuperBase {
    int key;
  }
  class NumSuperValue extends NumSuperBase;
  association numSuperMap NumSuperOwner [[key]] -> (byKey) NumSuperValue [1];

  // NumSub
  class NumSubOwner;
  class NumSubBase {
    int key;
  }
  class NumSubValue extends NumSubBase;
  association numSubMap NumSubOwner [[key]] -> (byKey) NumSubBase [1];

  // NumAbstract
  class NumAbstractOwner;
  abstract class NumAbstractBase {
    int key;
  }
  class NumAbstractValue extends NumAbstractBase;
  association numAbstractMap NumAbstractOwner [[key]] -> (byKey) NumAbstractBase [1];

  // ObjPlain
  class ObjPlainOwner;
  class ObjPlainValue {
    MapKey key;
  }
  association objPlainMap ObjPlainOwner [[key]] -> (byKey) ObjPlainValue [1];

  // ObjSuper
  class ObjSuperOwner;
  class ObjSuperBase {
    MapKey key;
  }
  class ObjSuperValue extends ObjSuperBase;
  association objSuperMap ObjSuperOwner [[key]] -> (byKey) ObjSuperValue [1];

  // ObjSub
  class ObjSubOwner;
  class ObjSubBase {
    MapKey key;
  }
  class ObjSubValue extends ObjSubBase;
  association objSubMap ObjSubOwner [[key]] -> (byKey) ObjSubBase [1];

  // ObjAbstract
  class ObjAbstractOwner;
  abstract class ObjAbstractBase {
    MapKey key;
  }
  class ObjAbstractValue extends ObjAbstractBase;
  association objAbstractMap ObjAbstractOwner [[key]] -> (byKey) ObjAbstractBase [1];

  // RolePlain
  class RolePlainOwner;
  class RolePlainValue;
  association rolePlainKey RolePlainValue -> (key) MapKey [1];
  association rolePlainMap RolePlainOwner [[key]] -> (byKey) RolePlainValue [1];

  // RoleSuper
  class RoleSuperOwner;
  class RoleSuperBase;
  class RoleSuperValue extends RoleSuperBase;
  association roleSuperKey RoleSuperBase -> (key) MapKey [1];
  association roleSuperMap RoleSuperOwner [[key]] -> (byKey) RoleSuperValue [1];

  // RoleSub
  class RoleSubOwner;
  class RoleSubBase;
  class RoleSubValue extends RoleSubBase;
  association roleSubKey RoleSubBase -> (key) MapKey [1];
  association roleSubMap RoleSubOwner [[key]] -> (byKey) RoleSubBase [1];

  // RoleAbstract
  class RoleAbstractOwner;
  abstract class RoleAbstractBase;
  class RoleAbstractValue extends RoleAbstractBase;
  association roleAbstractKey RoleAbstractBase -> (key) MapKey [1];
  association roleAbstractMap RoleAbstractOwner [[key]] -> (byKey) RoleAbstractBase [1];

  // Type qualified associations (GemMaps), see GemMapSyncTestGenerator: the key is chosen on put, the values have no
  // key attribute.
  // Names: Typ<Key><Value>, Value as above (Super: the value has a superclass <Case>Base).
  //   Key:   Str  [String] (GemValueMap)
  //          Num  [int]    (GemValueMap)
  //          Obj  [MapKey] (GemEntryMap)

  // TypStrPlain
  class TypStrPlainOwner;
  class TypStrPlainValue;
  association typStrPlainMap TypStrPlainOwner [String] -> (byKey) TypStrPlainValue [1];

  // TypStrSuper
  class TypStrSuperOwner;
  class TypStrSuperBase;
  class TypStrSuperValue extends TypStrSuperBase;
  association typStrSuperMap TypStrSuperOwner [String] -> (byKey) TypStrSuperValue [1];

  // TypStrSub
  class TypStrSubOwner;
  class TypStrSubBase;
  class TypStrSubValue extends TypStrSubBase;
  association typStrSubMap TypStrSubOwner [String] -> (byKey) TypStrSubBase [1];

  // TypStrAbstract
  class TypStrAbstractOwner;
  abstract class TypStrAbstractBase;
  class TypStrAbstractValue extends TypStrAbstractBase;
  association typStrAbstractMap TypStrAbstractOwner [String] -> (byKey) TypStrAbstractBase [1];

  // TypNumPlain
  class TypNumPlainOwner;
  class TypNumPlainValue;
  association typNumPlainMap TypNumPlainOwner [int] -> (byKey) TypNumPlainValue [1];

  // TypNumSuper
  class TypNumSuperOwner;
  class TypNumSuperBase;
  class TypNumSuperValue extends TypNumSuperBase;
  association typNumSuperMap TypNumSuperOwner [int] -> (byKey) TypNumSuperValue [1];

  // TypNumSub
  class TypNumSubOwner;
  class TypNumSubBase;
  class TypNumSubValue extends TypNumSubBase;
  association typNumSubMap TypNumSubOwner [int] -> (byKey) TypNumSubBase [1];

  // TypNumAbstract
  class TypNumAbstractOwner;
  abstract class TypNumAbstractBase;
  class TypNumAbstractValue extends TypNumAbstractBase;
  association typNumAbstractMap TypNumAbstractOwner [int] -> (byKey) TypNumAbstractBase [1];

  // TypObjPlain
  class TypObjPlainOwner;
  class TypObjPlainValue;
  association typObjPlainMap TypObjPlainOwner [MapKey] -> (byKey) TypObjPlainValue [1];

  // TypObjSuper
  class TypObjSuperOwner;
  class TypObjSuperBase;
  class TypObjSuperValue extends TypObjSuperBase;
  association typObjSuperMap TypObjSuperOwner [MapKey] -> (byKey) TypObjSuperValue [1];

  // TypObjSub
  class TypObjSubOwner;
  class TypObjSubBase;
  class TypObjSubValue extends TypObjSubBase;
  association typObjSubMap TypObjSubOwner [MapKey] -> (byKey) TypObjSubBase [1];

  // TypObjAbstract
  class TypObjAbstractOwner;
  abstract class TypObjAbstractBase;
  class TypObjAbstractValue extends TypObjAbstractBase;
  association typObjAbstractMap TypObjAbstractOwner [MapKey] -> (byKey) TypObjAbstractBase [1];

  // long keys, Plain only (the key dimension is independent of the value hierarchy): the keys are close to the
  // largest integer a browser represents exactly (GemValueMap#isSafeKey)
  //   LongPlain     [[key]], long key attribute (GemValueMap)
  //   TypLongPlain  [long] (GemValueMap)

  // LongPlain
  class LongPlainOwner;
  class LongPlainValue {
    long key;
  }
  association longPlainMap LongPlainOwner [[key]] -> (byKey) LongPlainValue [1];

  // TypLongPlain
  class TypLongPlainOwner;
  class TypLongPlainValue;
  association typLongPlainMap TypLongPlainOwner [long] -> (byKey) TypLongPlainValue [1];
}
