/* (c) https://github.com/MontiCore/monticore */

umlp QualifiedAssocs {

  class Directory;

  class Person {
    String login;
    int number;
  }

  class Admin extends Person;

  class Department {
    String name;
  }

  class Employee {
    String name;
    Department department;
  }

  /* GemValueMaps: keyed by an attribute of the target */
  association Directory [[login]] (loginDirectory) -> (byLogin) Person [1];
  association Directory [[number]] (numberDirectory) -> (byNumber) Person [1];
  association Directory [[name]] (departmentDirectory) -> (departmentByName) Department [1];

  /* GemValueMap: the key attribute is declared in the superclass of the target */
  association Directory [[login]] (adminDirectory) -> (adminByLogin) Admin [1];

  /* GemEntryMap: keyed by the domain object the target references */
  association Directory [[department]] (employeeDirectory) -> (byDepartment) Employee [1];

  /* GemValueMap with the qualifier on the right side: navigable from right to left, so the owner Directory is the
     right side of the association (and of its table) */
  association [1] Person (byLoginFromRight) <- (rightDirectory) [[login]] Directory;

  /* type qualified: the key is chosen on put and stored in the association table */
  association Directory [String] (codeDirectory) -> (byCode) Person [1];
  association Directory [int] (seatDirectory) -> (bySeat) Person [1];
  association Directory [Department] (headDirectory) -> (headByDepartment) Person [1];
  association [1] Person (byAliasFromRight) <- (aliasDirectory) [String] Directory;

  /* long keys: a browser represents only the integers within -(2^53-1) and 2^53-1 exactly, larger keys are refused */
  class Badge {
    long code;
  }
  association Directory [[code]] (badgeDirectory) -> (byBadgeCode) Badge [1];
  association Directory [long] (phoneDirectory) -> (byPhone) Person [1];

  /* a singleton owner of type qualified maps: deleting a value or a key object removes its entries there as well */
  <<singleton>>
  class Registry;
  association Registry [String] (codeRegistry) -> (byCode) Person [1];
  association Registry [Department] (headRegistry) -> (headByDepartment) Person [1];
}
