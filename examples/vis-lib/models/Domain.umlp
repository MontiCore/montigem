import java.time.LocalDateTime;
import mc.fenix.charts.GemBarChartTypes.GemBarChartData;
import mc.fenix.charts.GemPieChartTypes.GemPieChartData;

classdiagram Domain {
  class PersonPersonPersonPersonPersonPersonPersonPersonPersonPersonPersonPerson {
    String namenamenamenamenamenamenamenamenamenamenamenamenamenamenamenamenamenamenamename;
    String aboutMe;
  }

  class AddressAddressAddressAddressAddressAddressAddressAddressAddressAddress {
    String street;
    int house;
  }

  association [1] PersonPersonPersonPersonPersonPersonPersonPersonPersonPersonPersonPerson -> (addressaddressaddressaddressaddressaddressaddressaddressaddressaddress) AddressAddressAddressAddressAddressAddressAddressAddressAddressAddress [0..1];


  class Data {
    /Optional<GemBarChartData> bcData;
  }

  class Conversation {
    String conversationid;
  }

  class Message {
    String content;
    Role sender;
    Role receiver;
    LocalDateTime timestamp;
  }

  enum Role {
    SYSTEM, USER, ASSISTANT, TOOL;
  }

  class Person {
    java.time.LocalDate birthday;
    String name;
    String aboutMe;
    ?boolean employed;
    Optional<Role> role;
    Optional<String> tempStatus;
  }

  class Address {
    String street;
    int house;
  }

  class Stock {
    java.time.LocalDateTime date;
    String name;
    int price;
  }

  class Club {
    String name;
  }

  <<singleton>>
  class App {
    Boolean isOld(Person p);
    GemBarChartData getBarChart(List<Person> persons, String date);
    GemPieChartData getPieChart(List<Person> persons, String date);
  }

  <<singleton>>
  class FischertechnikSortingLineState{
      boolean pumpRunning = false;
      boolean pusher1Extended = false;
      boolean pusher2Extended = false;
      boolean pusher3Extended = false;
      boolean beltRunning = false;

      boolean barrierIndicator1On = false;
      boolean barrierIndicator2On = false;
      boolean barrierIndicator3On = false;
      boolean barrierIndicatorFeed1On = false;
      boolean barrierIndicatorFeed2On = false;

      String colorSensor = "white";
  }

  <<singleton>>
  class FischertechnikMultiProcessingStationState {
    // Outputs of the machine (sensors)
    boolean refSwitchTurnTableAtVacuum = false;
    boolean refSwitchTurnTableAtBelt = false;
    boolean refSwitchTurnTableAtSaw = false;
    boolean lightBarrierConveyorEnd = false;
    boolean refSwitchFeederInside = false;
    boolean refSwitchFeederOutside = false;
    boolean refSwitchVacuumAtTurnTable = false;
    boolean refSwitchVacuumAtOven = false;
    boolean lightBarrierOven = false;

    // Inputs of the machine (actuators)
    boolean moveTurnTableClockwise = false;
    boolean moveTurnTableCounterclockwise = false;
    boolean moveConveyorForward = false;
    boolean enableSaw = false;
    boolean moveOvenFeederRetract = false;
    boolean moveOvenFeederExtend = false;
    boolean moveVacuumToOven = false;
    boolean moveVacuumToTurnTable = false;
    boolean enableOvenLight = false;
    boolean enableCompressor = false;
    boolean enableValveVacuum = false;
    boolean enableValveMoveVacuum = false;
    boolean enableValveMoveOvenDoor = false;
    boolean enableValveMoveFeeder = false;
  }

  <<singleton>>
  class FischertechnikConveyorState{
    boolean moveToFeed = false;
    boolean moveToSwap = false;
    boolean feedDetectorOn = false;
    boolean swapDetectorOn = false;
  }

  <<singleton>>
  class FischertechnikVacuumGripperState {
    int rotationDeg = 0;
    boolean refSwitchRotation = false;
    int verticalPercentage = 0;
    boolean refSwitchVertical = false;
    int horizontalPercentage = 0;
    boolean refSwitchHorizontal = false;
    boolean pumpRunning = false;
    boolean valveEnabled = false;
  }

  <<singleton>>
  class FischertechnikWarehouseState {
    int depthPercentage = 0;
    int verticalPercentage = 0;
    int horizontalPercentage = 0;
  }

  <<singleton>>
  class AiService {
    Message answer(Message m);
  }

  association home [1] Person -> (address) Address [0..1];

  association friends [*] Person -> (friends) Person [*];

  association stocks [*] Person -> (stocks) Stock [*];

  association [*] Club -> (members) Person [*];

  association [1] Conversation -> (messages) Message[*];

}
