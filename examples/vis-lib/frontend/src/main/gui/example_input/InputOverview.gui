package example_input;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import common.ComponentCard;

import example_input.GemTextInputExample;
import example_input.GemNumberInputExample;
import example_input.GemTextareaInputExample;
import example_input.GemCheckBoxInputExample;
import example_input.GemRadioInputExample;
import example_input.GemDropdownInputExample;
import example_input.GemAutocompleteInputExample;
import example_input.GemRangeInputExample;
import example_input.GemChatExample;
import example_input.GemDateInputExample;

page InputOverview() {
  @GemColumn(
    hAlign = "center",
    components = [
      @GemText(value = "Input Components", size = "2rem", weight = "bold", height = "auto", width = "auto"),
      @GemText(value = "Forms and user input", size = "1.2rem", color = "gray", height = "auto", width = "auto"),

      @GemRow(
        wrap = "wrap",
        hAlign = "center",
        rowGap = "20px",
        colGap = "20px",
        width = "100%",
        components = [
            @ComponentCard(title = "Text Input", icon = "input", description = "Single-line text field.", click = navigate(@GemTextInputExample())),
            @ComponentCard(title = "Number Input", icon = "pin", description = "Numeric input field.", click = navigate(@GemNumberInputExample())),
            @ComponentCard(title = "Text Area", icon = "notes", description = "Multi-line text field.", click = navigate(@GemTextareaInputExample())),
            @ComponentCard(title = "Checkbox", icon = "check_box", description = "Binary choice input.", click = navigate(@GemCheckBoxInputExample())),
            @ComponentCard(title = "Radio Button", icon = "radio_button_checked", description = "Select one from many.", click = navigate(@GemRadioInputExample())),
            @ComponentCard(title = "Dropdown", icon = "arrow_drop_down_circle", description = "Select from a list.", click = navigate(@GemDropdownInputExample())),
            @ComponentCard(title = "Autocomplete", icon = "search", description = "Input with suggestions.", click = navigate(@GemAutocompleteInputExample())),
            @ComponentCard(title = "Range Input", icon = "linear_scale", description = "Slider for numeric range.", click = navigate(@GemRangeInputExample())),
            @ComponentCard(title = "Chat", icon = "chat", description = "Chat interface component.", click = navigate(@GemChatExample())),
            @ComponentCard(title = "DateTime", icon = "calendar_month", description = "Date and time component.", click = navigate(@GemDateInputExample()))
        ]
      )
    ]
  );
}
