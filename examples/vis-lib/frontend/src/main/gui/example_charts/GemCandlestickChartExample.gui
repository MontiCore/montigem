package example_charts;

import Domain.Person;
import mc.fenix.charts.GemCandlestickChart;
import common.ExamplePage;

page GemCandlestickChartExample() {
  @ExamplePage(
    component = @GemCandlestickChart(
      data = getData(),
      showConfig = true
