package example_charts;

import Domain.Person;
import mc.fenix.charts.GemTimeSeriesChart;
import common.ExamplePage;
import example_charts.GemTimeSeriesChartNotes;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;

page GemTimeSeriesChartExmaple (List<Person> persons, String lastClickedEvent = "No event clicked yet") {
  @ExamplePage(
    notes = @GemTimeSeriesChartNotes(),
    component = @GemColumn(components = [
      chart1@GemTimeSeriesChart(
        data = computeData1(persons),
        hideLiveDataToggle = true,
        showConfig = true
      ),
      @GemText(value = "Clicked Annotation: " + lastClickedEvent, size = "1.2rem"),
      chart2@GemTimeSeriesChart(
        data = computeData2(persons),
        hideLiveDataToggle = false,
        viewPort = "60s",
        eventClick = onEventClick(),
        showConfig = true
      )
    ]),
    basePath = "example_charts",
    componentName = "GemTimeSeriesChartExmaple"
  );
}
