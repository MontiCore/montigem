package example_charts;

import mc.fenix.charts.GemBoxPlot;
import common.ExamplePage;
import mc.fenix.arrange.GemColumn;

page GemBoxPlotExample()
{
  @ExamplePage(
    component = @GemColumn(components = [
      secondBoxplot@GemBoxPlot(
        data = getSecondBoxPlotData(),
        min = 0.0,
        width = getSecondBoxPlotWidth(),
        height = getSecondBoxPlotHeight(),
        horizontal=false,
        showConfig = true
      ),
      boxplot@GemBoxPlot(
        data = getBoxPlotData(),
        min = -5.0,
        width = getBoxPlotWidth(),
        height = getBoxPlotHeight(),
        showConfig = true
      )
    ]),
    basePath = "example_charts",
    componentName = "GemBoxPlotExample"
  );
}
