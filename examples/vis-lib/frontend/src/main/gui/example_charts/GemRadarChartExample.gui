package example_charts;

import Domain.Person;
import mc.fenix.charts.GemRadarChart;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.input.GemCheckBoxInput;
import mc.fenix.input.GemRangeInput;
import common.ExamplePage;

page GemRadarChartExample(
  List<Person> persons,
  String width = "600px",
  String height = "600px",
  boolean showLegend = true,
  boolean showLabels = true,
  int opacityPercent = 40
)
{
  @ExamplePage(
    component = @GemColumn(components = [
        @GemRow(wrap = "wrap", components = [
          @GemButton(label = "Height +", leftClick = changeHeight(50)),
          @GemButton(label = "Height -", leftClick = changeHeight(-50)),
          @GemText(value = "Height: " + height),
          @GemButton(label = "Width +", leftClick = changeWidth(50)),
          @GemButton(label = "Width -", leftClick = changeWidth(-50)),
          @GemText(value = "Width: " + width)
        ]),
        @GemRow(wrap = "wrap", vAlign = "center", hAlign = "left", components = [
          @GemCheckBoxInput(labelText = "Show Legend", checked = showLegend),
          @GemCheckBoxInput(labelText = "Show Labels", checked = showLabels)
        ]),
        @GemRow(
          width = "auto",
          height = height,
          components = [
            @GemColumn(
              width = width,
              components = [
                @GemRow(
                  height = "100%",
                  components = [
                    radarchart@GemRadarChart(
                      data = getData(),
                      fill = true,
                      stepSize = 1.0,
                      min = 0.0,
                      max = 5.0,
                      width = "100%",
                      height = "100%",
                      showLegend = showLegend,
                      showLabels = showLabels,
                      opacity = opacityPercent / 100.0,
                      showConfig = true
                    )
                  ]
                )
              ]
            ),
            @GemColumn(
              width = "auto",
              hAlign = "center",
              components = [
                @GemRangeInput(
                  vertical = true,
                  labelText = "Opacity",
                  minValue = 0,
                  maxValue = 100,
                  step = 10,
                  value = opacityPercent,
                  // label and min/max values need 126px, so the whole slider is as high as the chart
                  size = "calc(" + height + " - 126px)"
                )
              ]
            )
          ]
        )
    ]),
    basePath = "example_charts",
    componentName = "GemRadarChartExample"
  );
}
