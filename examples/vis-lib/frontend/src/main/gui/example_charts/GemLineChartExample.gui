package example_charts;

import Domain.Person;
import mc.fenix.charts.GemLineChart;
import common.ExamplePage;
import mc.fenix.arrange.GemRow;

page GemLineChartExample(List<Person> persons) {
  @ExamplePage(
    component = @GemRow(height = "450px", components = [
      linechart@GemLineChart(
        data = null,
        enableBackgroundColor = false,
        maxValue = null,
        minValue = null,
        showConfig = true
      )
    ]),
    basePath = "example_charts",
    componentName = "GemLineChartExample"
  );
}
