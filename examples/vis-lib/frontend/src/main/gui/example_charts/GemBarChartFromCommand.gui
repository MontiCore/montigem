package example_charts;

import mc.fenix.charts.GemBarChart;
import mc.fenix.charts.GemPieChart;

import Domain.App;
import Domain.Person;
import mc.fenix.charts.GemChartTypes.LegendPosition;

page GemBarChartFromCommand(App app, List<Person> persons, String myStringValue = "default")
{
  barchart@GemBarChart(
    legendPosition = LegendPosition.RIGHT,
    data = app.getBarChart(persons, myStringValue),
    stacked = false,
    maxValue = 10,
    minValue = null,
    showConfig = true
  );
  piechart@GemPieChart(
    legendPosition = LegendPosition.BOTTOM,
    data = app.getPieChart(persons, myStringValue),
    showConfig = true
  );
}
