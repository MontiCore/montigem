package example_charts;

import Domain.Person;
import mc.fenix.charts.GemBarChart;
import common.ExamplePage;

page GemBarChartExample(List<Person> persons) 
{
  @ExamplePage(
    component = barchart@GemBarChart(
      data = null,
      stacked = false,
      maxValue = 10,
      minValue = null,
      showConfig = true
    ),
    basePath = "example_charts",
    componentName = "GemBarChartExample"
  );
}
