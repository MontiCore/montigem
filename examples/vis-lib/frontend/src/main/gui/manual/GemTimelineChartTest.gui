package manual;

import Domain.Person;
import mc.fenix.charts.GemTimelineChart;
import manual.*;

page GemTimelineChartTest (List<Person> persons) {
  @LayoutTester(input =
    @GemTimelineChart(
      data = computeDate(persons),
      blockClick = getBlockClick(),
      height = "100%",
      showConfig = true
    )
  );
}
