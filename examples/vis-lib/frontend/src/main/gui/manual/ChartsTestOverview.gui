package manual;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import common.ComponentCard;

import manual.GemBarChartTest;
import manual.GemBoxPlotTest;
import manual.GemBulletChartTest;
import manual.GemCandlestickChartTest;
import manual.GemGaugeChartTest;
import manual.GemHeatmapChartTest;
import manual.GemLineChartTest;
import manual.GemGraphTest;
import manual.GemPieChartTest;
import manual.GemSunburstChartTest;
import manual.GemTimelineChartTest;
import manual.GemTimeSeriesChartTest;
import manual.GemVennDiagramTest;

page ChartsTestOverview() {
  @GemColumn(
    hAlign = "center",
    components = [
      @GemText(value = "Chart Tests Overview", size = "2rem", weight = "bold", height = "auto", width = "auto"),
      @GemText(value = "Manual test pages for chart components", size = "1.2rem", color = "gray", height = "auto", width = "auto"),

      @GemRow(
        wrap = "wrap",
        hAlign = "center",
        rowGap = "20px",
        colGap = "20px",
        width = "100%",
        components = [
            @ComponentCard(title = "Bar Chart Test", icon = "bar_chart", description = "Test scenarios for Bar Charts.", click = navigate(@GemBarChartTest())),
            @ComponentCard(title = "Pie Chart Test", icon = "pie_chart", description = "Test scenarios for Pie Charts.", click = navigate(@GemPieChartTest())),
            @ComponentCard(title = "Line Chart Test", icon = "show_chart", description = "Test scenarios for Line Charts.", click = navigate(@GemLineChartTest())),
            @ComponentCard(title = "Gauge Chart Test", icon = "speed", description = "Test scenarios for Gauge Charts.", click = navigate(@GemGaugeChartTest())),
            @ComponentCard(title = "Venn Diagram Test", icon = "bubble_chart", description = "Test scenarios for Venn Diagrams.", click = navigate(@GemVennDiagramTest())),
            @ComponentCard(title = "Network Graph Test", icon = "hub", description = "Test scenarios for Network Graphs.", click = navigate(@GemGraphTest())),
            @ComponentCard(title = "Heatmap Test", icon = "grid_on", description = "Test scenarios for Heatmaps.", click = navigate(@GemHeatmapChartTest())),
            @ComponentCard(title = "Sunburst Test", icon = "donut_large", description = "Test scenarios for Sunburst Charts.", click = navigate(@GemSunburstChartTest())),
            @ComponentCard(title = "Timeline Test", icon = "view_timeline", description = "Test scenarios for Timelines.", click = navigate(@GemTimelineChartTest())),
            @ComponentCard(title = "Time Series Test", icon = "timeline", description = "Test scenarios for Time Series Charts.", click = navigate(@GemTimeSeriesChartTest())),
            @ComponentCard(title = "Box Plot Test", icon = "candlestick_chart", description = "Test scenarios for Box Plots.", click = navigate(@GemBoxPlotTest())),
            @ComponentCard(title = "Bullet Chart Test", icon = "linear_scale", description = "Test scenarios for Bullet Charts.", click = navigate(@GemBulletChartTest())),
            @ComponentCard(title = "Candlestick Test", icon = "waterfall_chart", description = "Test scenarios for Candlestick Charts.", click = navigate(@GemCandlestickChartTest()))
        ]
      )
    ]
  );
}
