package manual;

import Domain.Person;
import mc.fenix.charts.GemGaugeChart;
import manual.*;

page GemGaugeChartTest(List<Person> persons) {

  @LayoutTester(input =
    @GemGaugeChart(
      data = getData(),
      min = 0,
      max = 50,
      unit = "#friends",
      textValue = "average number of friends for age group",
      textPosition = "bottom",
      showConfig = true
    )
  );

}
