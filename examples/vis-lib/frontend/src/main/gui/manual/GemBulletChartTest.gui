package manual;

import mc.fenix.charts.GemBulletChart;
import manual.*;

// E2E Test Wrapper: Keine Parameter in der Signatur!
page GemBulletChartTest() {

  // Chart 1: Standard-Werte
  @LayoutTester(input =
    bulletchartNormal@GemBulletChart(
      value = 0,
      reference = 4000,
      thresholdvalue = 4000,
      title = "Profit of MontiCore Inc.",
      subtitle = "in US $",
      range = [0, 5000],
      steps = [1000, 2000, 3000, 4000],
      showConfig = true
    )
  );

  // Chart 2: Extrem-Werte zum Testen der Border-Clippings (langer Titel, große Deltas)
  @LayoutTester(input =
    bulletchartExtreme@GemBulletChart(
      value = 9500000,
      reference = 4000000,
      thresholdvalue = 8000000,
      title = "An extremely long title that should definitely test the left margin",
      subtitle = "Currency units in millions of USD",
      range = [-2000000, 15000000],
      steps = [0, 5000000, 10000000],
      showConfig = true
    )
  );
}
