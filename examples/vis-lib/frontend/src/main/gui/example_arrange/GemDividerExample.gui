package example_arrange;

import mc.fenix.arrange.GemDivider;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import mc.fenix.navigation.GemNavList;
import mc.fenix.navigation.GemNavItem;
import common.ExamplePage;

page GemDividerExample() {
  @ExamplePage(
    component = @GemColumn(
      width = "100%",
      components = [
        @GemText(value = "Content Above Divider", weight = "bold"),
        @GemDivider(),
        @GemText(value = "Content Below Default Divider (1px, #e0e0e0, margin 10px 0)"),
        @GemDivider(height = "3px", color = "#1976d2", margin = "25px 0"),
        @GemText(value = "Content Below Custom Divider (3px, #1976d2, margin 25px 0)"),

        @GemDivider(margin = "30px 0"),

        @GemText(value = "Divider in GemNavList", size = "1.5rem", weight = "bold"),
        @GemNavList(
          width = "250px",
          components = [
            @GemNavItem(title = "Dashboard", target = "#"),
            @GemNavItem(title = "Profile", target = "#"),
            @GemDivider(margin = "8px 0"),
            @GemNavItem(title = "Settings", target = "#"),
            @GemNavItem(title = "Help", target = "#"),
            @GemDivider(margin = "8px 0"),
            @GemNavItem(title = "Logout", target = "#")
          ]
        )
      ]
    ),
    basePath = "example_arrange",
    componentName = "GemDividerExample"
  );
}