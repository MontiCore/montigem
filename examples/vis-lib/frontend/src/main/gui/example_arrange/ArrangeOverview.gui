package example_arrange;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import common.ComponentCard;

import example_arrange.GemGridExample;
import example_arrange.GemRowExample;
import example_arrange.GemColumnExample;
import example_arrange.GemCardExample;
import example_arrange.GemDialogExample;
import example_arrange.GemTreeNodeExample;
import example_arrange.GemDividerExample;
import example_table.GemTableExample;

page ArrangeOverview() {
  @GemColumn(
    hAlign = "center",
    components = [
      @GemText(value = "Layout & Arrange", size = "2rem", weight = "bold", height = "auto", width = "auto"),
      @GemText(value = "Structure your page", size = "1.2rem", color = "gray", height = "auto", width = "auto"),

      @GemRow(
        wrap = "wrap",
        hAlign = "center",
        rowGap = "20px",
        colGap = "20px",
        width = "100%",
        components = [
            @ComponentCard(title = "Grid", icon = "grid_view", description = "2D grid layout.", click = navigate(@GemGridExample())),
            @ComponentCard(title = "Row", icon = "view_column", description = "Horizontal layout.", click = navigate(@GemRowExample())),
            @ComponentCard(title = "Column", icon = "view_stream", description = "Vertical layout.", click = navigate(@GemColumnExample())),
            @ComponentCard(title = "Card", icon = "crop_portrait", description = "Container with header.", click = navigate(@GemCardExample())),
            @ComponentCard(title = "Dialog", icon = "open_in_new", description = "Modal dialog window.", click = navigate(@GemDialogExample())),
            @ComponentCard(title = "Divider", icon = "horizontal_rule", description = "Visual separator line.", click = navigate(@GemDividerExample())),
            @ComponentCard(title = "Tree Node", icon = "account_tree", description = "Hierarchical tree structure.", click = navigate(@GemTreeNodeExample())),
            @ComponentCard(title = "Table", icon = "table_chart", description = "Data table.", click = navigate(@GemTableExample()))
        ]
      )
    ]
  );
}
