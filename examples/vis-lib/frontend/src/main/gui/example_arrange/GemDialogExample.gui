package example_arrange;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemDialog;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemLink;
import mc.fenix.arrange.GemColumn;
import common.ExamplePage;
import example_arrange.GemDialogNotes;

page GemDialogExample(?boolean dialogOpen = false) {
  @ExamplePage(
    notes = @GemDialogNotes(),
    component = @GemColumn(components = [
      @GemButton(label = "Click Me!", leftClick = openDialog()),
      dialog@GemDialog(isOpen = dialogOpen, component =
        @GemCard(
          title = "Info Text",
          component = @GemText(value = "Some Text")
        )
      )
    ]),
    basePath = "example_arrange",
    componentName = "GemDialogExample"
  );
}
