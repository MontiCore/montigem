package example_arrange;

import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemColumn;
import common.ExamplePage;
import example_arrange.GemRowNotes;

page GemRowExample() {
  @ExamplePage(
    notes = @GemRowNotes(),
    component = @GemColumn(components = [
      @GemRow(
        colGap = "15px",
        components = [
          @GemText(value = "First col"),
          @GemText(value = "Second col"),
          @GemText(value = "Third col")
        ]
      )
    ]),
    basePath = "example_arrange",
    componentName = "GemRowExample"
  );
}
