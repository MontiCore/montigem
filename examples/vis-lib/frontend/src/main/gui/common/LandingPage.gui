/* (c) https://github.com/MontiCore/monticore */
package common;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemCard;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemIcon;
import mc.fenix.basic.GemLink;
import mc.fenix.input.GemTextInput;
import mc.fenix.editor.MonacoEditor;

import common.AboutMontiGem;
import common.ComponentCard;
import common.EntryCard;
import example_basic.BasicOverview;
import example_input.InputOverview;
import example_arrange.ArrangeOverview;
import example_charts.ChartsOverview;
import common.OtherOverview;

/*
  Landing page of the demonstrator and target of the root route (see
  AppGemRouting.ts): what this application is, how it was built, and where to go
  first. Order follows the questions a first-time visitor asks: what am I looking
  at (hero), how does the modeling work (the DSL section with model and result
  side by side), what is in the library (the five categories), how do I use the
  example pages (three steps), and who built it (background).
*/
page LandingPage(
    ?String demoCode
) {
  landingPageContainer@GemColumn(
    hAlign = "center",
    height = "100%",
    components = [

      // --- 1. Hero Section ---
      heroSection@GemColumn(
        hAlign = "center",
        vAlign = "center",
        height = "fit-content",
        width = "100%",
        rowGap = "0.75rem",
        components = [
            @GemIcon(name = "analytics", size = "100px", color = "white"),
            @GemText(value = "MontiGem Visualization Library", size = "3rem", weight = "bold", color = "white", height = "auto", width = "auto"),
            heroLead@GemText(value = "Every GUI component of the MontiGem runtime library in one running application - which was itself generated by MontiGem from models. Each example page shows a component at work, the GUI model it was generated from, the handwritten Java logic and the styling, and explains the component with the text of the library documentation.", size = "1.2rem", color = "#e0e0e0", height = "auto", width = "auto"),
            heroButtons@GemRow(width = "fit-content", height = "fit-content", hAlign = "center", vAlign = "center", colGap = "0.75rem", rowGap = "0.5rem", wrap = "wrap", components = [
              toCharts@GemButton(label = "Explore the charts", leftClick = navigate(@ChartsOverview())),
              toAbout@GemButton(label = "How this was built", leftClick = navigate(@AboutMontiGem()))
            ])
        ]
      ),

      // --- 2. The DSL Concept (Code vs Result) ---
      sectionContainer@GemColumn(
        width = "80%",
        hAlign = "center",
        height = "fit-content",
        components = [
            @GemText(value = "Write Models, Generate UI", size = "2.5rem", weight = "bold", color = "var(--text-main)", height = "auto", width = "auto"),
            @GemText(value = "A user interface is a model in the GUI DSL of MontiGem: a page or component declares its parameters and composes library components such as GemText, GemTextInput and GemButton. MontiGem generates the Angular component, its template and the data binding from it - the model on the left becomes the page on the right.", size = "1.2rem", color = "var(--text-muted)", height = "auto", width = "auto"),

            demoRow@GemRow(
                width = "100%",
                colGap = "40px",
                vAlign = "stretch",
                height = "fit-content",
                components = [
                    // Left: Code
                    @GemCard(
                        title = "MyPage.gui (the model)",
                        width = "50%",
                        component = codeBlock@GemColumn(
                            height = "auto",
                            components = [
                                @MonacoEditor(
                                    entry = demoCode,
                                    language = "java",
                                    disabled = true,
                                    theme = "vs",
                                    glyphMargin = false,
                                    height = "auto",
                                    autoHeight = true
                                )
                            ]
                        )
                    ),
                    // Right: Result
                    @GemCard(
                        title = "Rendered result (generated Angular component)",
                        width = "50%",
                        component = previewBlock@GemColumn(
                            hAlign = "center",
                            vAlign = "center",
                            rowGap = "15px",
                            height = "auto",
                            components = [
                                @GemText(value = "Hello World", size = "1.5rem", height = "auto", width = "auto"),
                                @GemTextInput(id = "demoInput", labelText = "Name"),
                                @GemButton(label = "Send")
                            ]
                        )
                    )
                ]
            ),
            dslHint@GemText(value = "Every example page of this demonstrator works the same way: the \"Show GUI\" button of the code viewer opens the model the page was generated from, \"Show Java\" the handwritten logic behind it, \"Show SCSS\" its styling.", size = "1rem", color = "var(--text-muted)", height = "auto", width = "auto")
        ]
      ),

      // --- 3. Component Library Overview ---
      sectionContainerLight@GemColumn(
        width = "100%",
        hAlign = "center",
        height = "fit-content",
        components = [
            @GemText(value = "The Component Library", size = "2.5rem", weight = "bold", color = "var(--text-main)", height = "auto", width = "auto"),
            @GemText(value = "The runtime library ships its GUI components in packages under mc.fenix - one npm package per group. This demonstrator has an example page for each of them.", size = "1.2rem", color = "var(--text-muted)", height = "auto", width = "auto"),
            @GemRow(
                wrap = "wrap",
                hAlign = "center",
                rowGap = "30px",
                colGap = "30px",
                width = "80%",
                height = "fit-content",
                components = [
                    @ComponentCard(title = "Basic Elements", icon = "check_box", description = "Text, icons, images, links, buttons, audio, video, a loading spinner and the dark mode switch.", click = navigate(@BasicOverview())),
                    @ComponentCard(title = "Input Forms", icon = "input", description = "Text, number, date and text-area inputs, checkboxes, radio buttons, dropdowns, autocomplete, sliders and a chat.", click = navigate(@InputOverview())),
                    @ComponentCard(title = "Layout & Arrange", icon = "dashboard", description = "Rows, columns, grids, cards, dialogs, trees and tables - the containers that structure a page.", click = navigate(@ArrangeOverview())),
                    @ComponentCard(title = "Data Visualization", icon = "insert_chart", description = "Fifteen chart types, from bar and line charts to heat maps, sunbursts, time series and network graphs.", click = navigate(@ChartsOverview())),
                    @ComponentCard(title = "Other Components", icon = "extension", description = "Monaco code editor, Markdown, 3D CAD viewer, component-and-connector diagrams and Fischertechnik stations.", click = navigate(@OtherOverview()))
                ]
            )
        ]
      ),

      // --- 4. How to use an example page ---
      stepsSection@GemColumn(
        width = "80%",
        hAlign = "center",
        height = "fit-content",
        components = [
          stepsCard@GemCard(title = "Try it in three steps", width = "100%", component =
            stepsRow@GemRow(width = "100%", height = "fit-content", colGap = "1.5rem", rowGap = "1rem", wrap = "wrap", components = [
              step1Col@GemColumn(width = "17rem", height = "fit-content", rowGap = ".35rem", components = [
                step1Title@GemText(width = "100%", height = "fit-content", weight = "bold", value = "1. Pick a component"),
                step1Text@GemText(width = "100%", height = "fit-content",
                  value = "Choose a category above or in the navigation bar and open one of its example pages.")
              ]),
              step2Col@GemColumn(width = "17rem", height = "fit-content", rowGap = ".35rem", components = [
                step2Title@GemText(width = "100%", height = "fit-content", weight = "bold", value = "2. Read the notes, then play"),
                step2Text@GemText(width = "100%", height = "fit-content",
                  value = "The dashed \"Demonstrator\" box explains what the component is for and what to try. \"Parameters\" lists every option with its documentation.")
              ]),
              step3Col@GemColumn(width = "17rem", height = "fit-content", rowGap = ".35rem", components = [
                step3Title@GemText(width = "100%", height = "fit-content", weight = "bold", value = "3. Look behind the page"),
                step3Text@GemText(width = "100%", height = "fit-content",
                  value = "Open the source with the code buttons and compare the GUI model with what you see. The Java file shows where the data comes from.")
              ])
            ])
          )
        ]
      ),

      // --- 5. Background ---
      backgroundSection@GemColumn(
        width = "80%",
        hAlign = "center",
        height = "fit-content",
        components = [
          entryGridTitle@GemText(value = "Background", size = "2rem", weight = "bold", color = "var(--text-main)", height = "auto", width = "auto"),
          entryGrid@GemRow(width = "100%", height = "fit-content", colGap = "1rem", rowGap = "1rem", wrap = "wrap", components = [
            @EntryCard(title = "Generated with MontiGem", icon = "auto_awesome",
              text = "Almost everything you see is generated: from a class diagram of the domain and the GUI models of these pages, MontiGem generates the database schema, the Java backend and this Angular frontend. Handwritten code only adds the logic of the examples.",
              action = toMontiGemAction@GemButton(label = "How this was built", leftClick = navigate(@AboutMontiGem()))),
            @EntryCard(title = "The library documentation", icon = "menu_book",
              text = "The explanations on the example pages are the doc comments of the component models - the same text that produces the online documentation of the component library. Open it for the full reference including the data types of the charts.",
              action = toDocsAction@GemLink(url = "https://monticore.pages.rwth-aachen.de/umlp/gendoc_components/Frontend-RTE.html", text = "GUI component library documentation")),
            @EntryCard(title = "Chair of Software Engineering", icon = "school",
              text = "MontiGem and its component library are developed at the Chair of Software Engineering of RWTH Aachen University, where the modeling languages and generators behind this application are researched and built.",
              action = toChairAction@GemLink(url = "https://www.se-rwth.de", text = "se-rwth.de"))
          ])
        ]
      )
    ]
  );
}
