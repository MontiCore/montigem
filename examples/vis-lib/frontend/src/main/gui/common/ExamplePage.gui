package common;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemIcon;
import mc.fenix.basic.GemText;

/**
  Frame of every example page of the demonstrator: the demonstrator notes on top
  (`notes`, usually a common.ExampleNotes wrapped by the example's own
  `<Name>Notes` component), then the toolbar that switches the source-code view,
  then the demonstrated `component` itself and - depending on `layoutMode` -
  the common.CodeViewer with the GUI model, the Java logic and the SCSS of the
  example next to or below it.

  The demonstrated component always sits in a column named examplePreview*
  (examplePreview in the default layout without code view): instance names
  become CSS classes, and the documentation screenshots (doc.ScreenshotGen)
  capture exactly that column.

  `basePath` and `componentName` locate the example's sources for the code
  viewer (they are copied to assets/source-code by the Gradle task
  copySourceCodeToAssets). `simple` replaces the four layout buttons by a single
  toggle for pages whose component does not cope with a split view.
*/
component ExamplePage(
  GUIViewElement component,
  String basePath,
  String componentName,
  Boolean simple = false,
  GUIViewElement notes,

  // Internal state
  String layoutMode = "hidden" // "fullscreen", "right", "bottom", "hidden"
) {

  // Demonstrator notes (empty when the page passes none)
  notesSlot@GemColumn(width = "100%", height = "fit-content", component = notes);

  // Toolbar
  @guard(!simple) {
    toolbar@GemRow(hAlign = "right", vAlign = "center", components = [
      @GemText(value = "Show/Hide Code:", width = "auto", height = "auto"),
      @GemRow(components = [
        @LayoutButton(mode = "fullscreen", currentMode = layoutMode, label = "Only Source", icon = "code", clickHandler = setLayoutFullscreen()),
        @LayoutButton(mode = "right", currentMode = layoutMode, label = "Right of GUI", icon = "vertical_split", clickHandler = setLayoutRight()),
        @LayoutButton(mode = "bottom", currentMode = layoutMode, label = "Below GUI", icon = "horizontal_split", clickHandler = setLayoutBottom()),
        @LayoutButton(mode = "hidden", currentMode = layoutMode, label = "Hide", icon = "visibility_off", clickHandler = setLayoutHidden())
      ])
    ]);
  } else {
    simpleToolbar@GemRow(hAlign = "right", vAlign = "center", components = [
      @GemButton(
        leftClick = toggleLayoutModeSimple(),
        content = [
          @GemRow(vAlign = "center", colGap = "5px", components = [
            @GemIcon(name = "code"),
            @GemText(value = "Toggle View")
          ])
        ]
      )
    ]);
  };

  // Content
  @guard(layoutMode == "fullscreen") {
      @CodeViewer(basePath = basePath, componentName = componentName, height = "100%", vertical = false);
  } else {
      @guard(layoutMode == "right") {
        @GemRow(wrap = "wrap", vAlign = "stretch", components = [
          @GemColumn(width = "50%", components = [
            examplePreviewRight@GemColumn(width = "100%", height = "100%", component = component)
          ]),
          @GemColumn(width = "48%", height = "100%", components = [
            @CodeViewer(basePath = basePath, componentName = componentName, height = "100%", vertical = true)
          ])
        ]);
      } else {
          @guard(layoutMode == "bottom") {
            @GemColumn(components = [
              examplePreviewBottom@GemColumn(width = "100%", height = "auto", component = component),
              @CodeViewer(basePath = basePath, componentName = componentName, vertical = false)
            ]);
          } else {
              // hidden
              examplePreview@GemColumn(width = "100%", height = "auto", component = component);
          };
      };
  };
}
