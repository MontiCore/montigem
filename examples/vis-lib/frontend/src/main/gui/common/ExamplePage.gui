package common;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemIcon;
import mc.fenix.basic.GemText;

component ExamplePage(
  GUIViewElement component,
  String basePath,
  String componentName,
  Boolean simple = false,

  // Internal state
  String layoutMode = "hidden" // "fullscreen", "right", "bottom", "hidden"
) {

  // Toolbar
  @guard(!simple) {
    @GemRow(hAlign = "right", vAlign = "center", components = [
      @GemText(value = "Show/Hide Code:", width = "auto", height = "auto"),
      @GemRow(components = [
        @LayoutButton(mode = "fullscreen", currentMode = layoutMode, label = "Only Source", icon = "code", clickHandler = setLayoutFullscreen()),
        @LayoutButton(mode = "right", currentMode = layoutMode, label = "Right of GUI", icon = "vertical_split", clickHandler = setLayoutRight()),
        @LayoutButton(mode = "bottom", currentMode = layoutMode, label = "Below GUI", icon = "horizontal_split", clickHandler = setLayoutBottom()),
        @LayoutButton(mode = "hidden", currentMode = layoutMode, label = "Hide", icon = "visibility_off", clickHandler = setLayoutHidden())
      ])
    ]);
  } else {
    @GemRow(hAlign = "right", vAlign = "center", components = [
      @GemButton(
        leftClick = toggleLayoutModeSimple(),
        content = [
          @GemRow(vAlign = "center", colGap = "5px", components = [
            @GemIcon(name = "code"),
            @GemText(value = "Toggle View")
          ])
        ]
      )
    ]);
  };

  // Content
  @guard(layoutMode == "fullscreen") {
      @CodeViewer(basePath = basePath, componentName = componentName, height = "100%", vertical = false);
  } else {
      @guard(layoutMode == "right") {
        @GemRow(wrap = "wrap", vAlign = "stretch", components = [
          @GemColumn(width = "50%", components = [
            @GemColumn(style = "example-preview", width = "100%", height = "100%", component = component)
          ]),
          @GemColumn(width = "48%", height = "100%", components = [
            @CodeViewer(basePath = basePath, componentName = componentName, height = "100%", vertical = true)
          ])
        ]);
      } else {
          @guard(layoutMode == "bottom") {
            @GemColumn(components = [
              @GemColumn(style = "example-preview", width = "100%", height = "auto", component = component),
              @CodeViewer(basePath = basePath, componentName = componentName, vertical = false)
            ]);
          } else {
              // hidden
              @GemColumn(style = "example-preview", width = "100%", height = "auto", component = component);
          };
      };
  };
}
