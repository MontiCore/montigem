package fischertechnik;

import fischertechnik.Conveyor_Demo;
import fischertechnik.MultiProcessingStation_Demo;
import fischertechnik.SortingLine_Demo;
import fischertechnik.VacuumGripper_Demo;
import fischertechnik.Warehouse_Demo;

import mc.fenix.arrange.GemCard;
import common.ExamplePage;
import fischertechnik.FischertechnikNotes;
import mc.fenix.arrange.GemColumn;

page FischertechnikExample(){
  @ExamplePage(
    notes = @FischertechnikNotes(),
    component = @GemColumn(width = "50%", components = [
      @GemCard(title="Conveyor", component=@Conveyor_Demo()),
      @GemCard(title="MultiProcessingStation", component=@MultiProcessingStation_Demo()),
      @GemCard(title="SortingLine", component=@SortingLine_Demo()),
      @GemCard(title="VacuumGripper", component=@VacuumGripper_Demo()),
      @GemCard(title="Warehouse", component=@Warehouse_Demo())
    ]),
    basePath = "fischertechnik",
    componentName = "FischertechnikExample"
  );
}
