package example_monaco;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemColumn;
import mc.fenix.editor.MonacoEditor;
import Domain.Person;
import common.ExamplePage;
import example_monaco.MonacoEditorNotes;

page ExampleFromLib(Person p) {
  @ExamplePage(
    notes = @MonacoEditorNotes(),
    component = @GemColumn(width = "100%", components = [
      @MonacoEditor(
        width = "100%",
        height = "200px",
        entry=p.aboutMe,
        disabled=false,
        theme="vs-light",
        highlighting = getHighlights(),
        hoverContents=getHoverContents(),
        initialScrollToLine = 20,
        language="mySpecialLanguage"
      ),
      @GemText(value="You will also have to add the following lines to your frontend's config/package.override.json and config/angular.override.json!"),
      @JsonSnippet(code = "{\n  \"dependencies\": {\n    \"@umlp/editor\": \"^<<insert correct version here>>>\"\n  }\n}"),
      @JsonSnippet(code = "{\n  \"projects\": {\n    \"client\": {\n      \"architect\": {\n        \"build\": {\n          \"options\": {\n            \"assets\": [\n              \"src/favicon.ico\",\n              \"src/assets\",\n              {\n                \"glob\": \"**/*\",\n                \"input\": \"node_modules/monaco-editor\",\n                \"output\": \"/assets/monaco/\"\n              }\n            ]\n          }\n        }\n      }\n    }\n  }\n}")
    ]),
    basePath = "example_monaco",
    componentName = "ExampleFromLib"
  );
}
