package example_cad;

import mc.fenix.cad.GemCAD;
import mc.fenix.cad.GemCADTypes.Marker;
import common.ExamplePage;
import example_cad.GemCADNotes;

page GemCADExample() {
  @ExamplePage(
    notes = @GemCADNotes(),
    component = cad@GemCAD(
      height = "500px",
      width = "100%",
      filePath = "assets/cad/test.gltf",
      markers = [
        Marker("", "red"),
        Marker("Blue Label", "blue"),
        Marker("Green Label", "green")
      ],
      onNodeClick = handleNodeClick()
    ),
    basePath = "example_cad",
    componentName = "GemCADExample"
  );
}
