package person;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import person.RowConfig.RowStyle;

page Row(
  GUIViewElement col1,
  GUIViewElement col2,
  GUIViewElement col3,
  GUIViewElement col4,
  RowStyle conf
) {
  @GemRow(colGap = conf.colGap, hAlign = conf.hAlign, components = [
    @GemColumn(width = "30%", components = [ col1 ]),
    @GemColumn(width = "30%", components = [ col2 ]),
    @GemColumn(width = "30%", components = [ col3 ]),
    @GemColumn(width = "30%", components = [ col4 ])
  ]);
}
