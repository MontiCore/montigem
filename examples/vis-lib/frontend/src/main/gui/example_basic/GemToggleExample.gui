package example_basic;

import mc.fenix.basic.GemToggle;
import common.ExamplePage;
import mc.fenix.arrange.GemColumn;

page GemToggleExample() {
  @ExamplePage(
    component = @GemColumn(components = [
      @GemToggle(
        label = "Notifications",
        state = true,
        color = "#16a34a",
        toggled = showState()
      ),
      @GemToggle(
        label = "Disabled",
        disabled = true,
        inactiveColor = "#64748b"
      )
    ]),
    basePath = "example_basic",
    componentName = "GemToggleExample"
  );
}
