package example_basic;

import mc.fenix.basic.GemStatusIcon;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import common.ExamplePage;

page GemStatusIconExample(?String trafficLight = "OK") {
  @ExamplePage(
    component = @GemColumn(rowGap = "15px", components = [
      // Default traffic light mapping: OK -> green, WARNING -> yellow, ERROR -> red
      @GemRow(colGap = "15px", components = [
        @GemStatusIcon(status = "OK", showLabel = true),
        @GemStatusIcon(status = "WARNING", showLabel = true),
        @GemStatusIcon(status = "ERROR", showLabel = true)
      ]),

      // Status that changes at runtime
      @GemRow(colGap = "15px", vAlign = "center", components = [
        @GemStatusIcon(status = currentStatus(), size = "40px", showLabel = true),
        @GemButton(label = "Next status", leftClick = nextStatus())
      ]),

      // Custom states (e.g. the constants of an enum) with own colors and icons
      @GemRow(colGap = "15px", components = [
        @GemStatusIcon(
          status = "RUNNING",
          states = ["RUNNING", "PAUSED", "STOPPED"],
          colors = ["#2e7d32", "orange", "rgb(198,40,40)"],
          icons = ["play_circle", "pause_circle", "stop_circle"],
          size = "32px",
          showLabel = true
        ),
        @GemStatusIcon(
          status = "PAUSED",
          states = ["RUNNING", "PAUSED", "STOPPED"],
          colors = ["#2e7d32", "orange", "rgb(198,40,40)"],
          icons = ["play_circle", "pause_circle", "stop_circle"],
          size = "32px",
          showLabel = true
        ),
        @GemStatusIcon(
          status = "STOPPED",
          states = ["RUNNING", "PAUSED", "STOPPED"],
          colors = ["#2e7d32", "orange", "rgb(198,40,40)"],
          icons = ["play_circle", "pause_circle", "stop_circle"],
          size = "32px",
          showLabel = true
        )
      ]),

      // Unknown status falls back to defaultColor
      @GemStatusIcon(status = "UNKNOWN", icon = "help", defaultColor = "gray", showLabel = true)
    ]),
    basePath = "example_basic",
    componentName = "GemStatusIconExample"
  );
}
