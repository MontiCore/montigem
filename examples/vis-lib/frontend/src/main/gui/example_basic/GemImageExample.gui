package example_basic;

import mc.fenix.basic.GemImage;
import mc.fenix.arrange.GemCard;
import common.ExamplePage;
import example_basic.GemImageNotes;
import mc.fenix.arrange.GemColumn;

page GemImageExample() {
  @ExamplePage(
    notes = @GemImageNotes(),
    component = @GemColumn(components = [
      @GemCard(component =
        @GemImage(
          source = "assets/images/World.png",
          alt = "Image of the Earth"
        )
      ),

      @GemImage(
        width = "300px",
        source = "assets/images/World.png",
        alt = "Image of the Earth"
      ),

      @GemImage(
        height = "300px",
        source = "assets/images/World.png",
        alt = "Image of the Earth"
      ),

      @GemImage(
        width = "30px",
        height = "30px",
        source = "assets/images/World.png",
        alt = "Image of the Earth"
      )
    ]),
    basePath = "example_basic",
    componentName = "GemImageExample"
  );
}
