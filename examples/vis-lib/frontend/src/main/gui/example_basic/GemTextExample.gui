package example_basic;

import mc.fenix.basic.GemText;
import common.ExamplePage;
import example_basic.GemTextNotes;

page GemTextExample() {
  @ExamplePage(
    notes = @GemTextNotes(),
    component = @GemText(
      value = "My text",
      color = "blue",
      size = "1rem",
      fontFamily = "'Lucida Console', Courier, monospace",
      fontStyle = "oblique 12deg",
      weight = "200",
      width = "200px",
      height = "3rem"
    ),
    basePath = "example_basic",
    componentName = "GemTextExample"
  );
}
