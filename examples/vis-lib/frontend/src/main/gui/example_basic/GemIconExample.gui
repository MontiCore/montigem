package example_basic;

import mc.fenix.basic.GemIcon;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemRow;
import common.ExamplePage;
import example_basic.GemIconNotes;
import mc.fenix.arrange.GemColumn;

page GemIconExample() {
  @ExamplePage(
    notes = @GemIconNotes(),
    component = @GemColumn(components = [
      @GemRow(
        colGap = "15px",
        components = [
          @GemIcon(
            name = "add",
            color = "blue",
            size = "1rem"
          ),
          @GemIcon(
            name = "edit",
            color = "rgb(95,99,104)",
            size = "24px"
          ),
          @GemIcon(
            name = "delete",
            color = "#ff0000",
            size = "2cm"
          )
        ]
      ),
      @GemButton(
        width = "fit-content",
        content = [
          @GemIcon(
            name = "home",
            color = "white",
            size = "30px"
          )
        ]
      )
    ]),
    basePath = "example_basic",
    componentName = "GemIconExample"
  );
}
