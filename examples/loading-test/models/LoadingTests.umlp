/* (c) https://github.com/MontiCore/monticore */

classdiagram LoadingTests {

  class Person {
    String name;
    int age;
  }

  class Student extends Person {
    int matNr;
  }

  class Animal {
    String name;
    int legs;
  }

  class Food {
    String name;
    MyEnum eAttr = MyEnum.A;
  }

  association [*] Person (owner) <-> (pet) Animal [*];
  association [0..1] Person (ownerOfFavAssoc) -> (favouritePet) Animal [0..1]; // once: unidirectional
  association [*] Animal -> Food [*];
  association [0..1] Animal (animalOfFavAssoc) <-> (favouriteFood) Food [0..1]; // and twice: bidirectional

  <<singleton>>
  class UpdateListHelper {
    <<command>>
    void replaceFoodItem(Animal a);
  }
  association UpdateListHelper -> (testAnimal) Animal [0..1];

  class CommandTest {
    Animal getAnimal();
    Long getLong();
    long getLongPrimitive();
    String getString();
    Optional<Animal> getOptAnimal();
    Optional<Long> getOptLong();
    List<Animal> getListAnimals();
    List<Long> getListLong();
    void doAction();
  }

  // From the loading-inner example
  public class Player {
      + String name;
      + boolean isActive;
      + int points;
    }

    public class Game {
      + int currentTurn;
      + long currentPlayerIndex;
      + boolean votingPhase;

      int gemIdForNav = -1;
    }

    composition [1] Game -> Player [*];

   // A class causing Game -> Player * -> PlayerStat *;
   public class PlayerStat {
    + String statID;
   }
   composition [1] Player -> PlayerStat [*];
   <<singleton>>
   class PlayerStatsManager {
     void addPlayerRemote(Game g);
     void addStatRemote(Game g);
     void reset(Game g);
   }
   association PlayerStatsManager -> Game [0..1];

  // And some tests for interfaces

  public class IUseAnInterface {
    MyInterface i;
  }
  public interface MyInterface { }
  public class MyInterfaceImpl implements MyInterface {
    String name;
  }

  public class LeftSide {
    String label;
  }
  public class RightSide {
    String label;
  }
  association [0..1] LeftSide (connectedLeft) <-> (connectedRight) RightSide [0..1];
  association [0..1] LeftSide (connectedLeftList) <-> (connectedRightList) RightSide [*];
  public class Sides {
    LeftSide left;
  }

  <<singleton>>
  public class AssocCommandCollector {
    // Create a new object & return it
    LeftSide constructNewLeftSide(String leftLabel, String rightLabel);

    // Create a new rightside to the connectedRight
    RightSide addNewRightSideTo(LeftSide leftSide, boolean setAssocInBuilder);
  }

  //public interface MyBetterInterface extends MyInterface {}
  //public class MyBetterInterfaceImpl implements MyBetterInterface {
  //    String name;
  //}

  enum MyEnum {
    A,B,C;
  }

  <<singleton>>
  class TestCommandUpdates {
    CommandTestResult doTestCommand(boolean doBuild);
  }
  class CommandTestResult {
    String field;
  }

  <<singleton>>
  class CounterService {
    int counter = 0;
  }

  // Attribute qualified associations (GemMaps): new owners, Student stays unchanged as a target

  class Faculty {
    String name;
  }

  class Course {
    String title;
    int ects;
  }

  class Staff {
    String staffId;
  }

  class Tutor extends Staff {
    int weeklyHours;
  }

  class Enrollment {
    Student student;
    int grade;
  }

  // GemValueMap, int key declared in the target
  association Course [[matNr]] (attendedCourse) -> (participantByMatNr) Student [*];

  // GemValueMap, String key declared in the target
  association Faculty [[title]] (faculty) -> (courseByTitle) Course [*];

  // GemValueMap, key declared in the superclass of the target
  association Course [[staffId]] (tutoredCourse) -> (tutorByStaffId) Tutor [*];

  // GemEntryMap, keyed by the referenced Student
  association Course [[student]] (enrollmentCourse) -> (enrollmentByStudent) Enrollment [*];
}
