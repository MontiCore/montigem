classdiagram LoadingTests {

  class Person {
    String name;
    int age;
  }

  class Student extends Person {
    int matNr;
  }

  class Animal {
    String name;
    int legs;
  }

  class Food {
    String name;
    MyEnum eAttr = MyEnum.A;
  }

  association [*] Person (owner) <-> (pet) Animal [*];
  association [0..1] Person (ownerOfFavAssoc) -> (favouritePet) Animal [0..1]; // once: unidirectional
  association [*] Animal -> Food [*];
  association [0..1] Animal (animalOfFavAssoc) <-> (favouriteFood) Food [0..1]; // and twice: bidirectional

  <<singleton>>
  class UpdateListHelper {
    <<command>>
    void replaceFoodItem(Animal a);
  }
  association UpdateListHelper -> (testAnimal) Animal [0..1];

  class CommandTest {
    Animal getAnimal();
    Long getLong();
    long getLongPrimitive();
    String getString();
    Optional<Animal> getOptAnimal();
    Optional<Long> getOptLong();
    List<Animal> getListAnimals();
    List<Long> getListLong();
    void doAction();
  }

  // From the loading-inner example
  public class Player {
      + String name;
      + boolean isActive;
      + int points;
    }

    public class Game {
      + int currentTurn;
      + long currentPlayerIndex;
      + boolean votingPhase;

      int gemIdForNav = -1;
    }

    composition [1] Game -> Player [*];

   // A class causing Game -> Player * -> PlayerStat *;
   public class PlayerStat {
    + String statID;
   }
   composition [1] Player -> PlayerStat [*];
   <<singleton>>
   class PlayerStatsManager {
     void addPlayerRemote(Game g);
     void addStatRemote(Game g);
     void reset(Game g);
   }
   association PlayerStatsManager -> Game [0..1];

  // And some tests for interfaces

  public class IUseAnInterface {
    MyInterface i;
  }
  public interface MyInterface { }
  public class MyInterfaceImpl implements MyInterface {
    String name;
  }

  public class LeftSide {
    String label;
  }
  public class RightSide {
    String label;
  }
  association [0..1] LeftSide (connectedLeft) <-> (connectedRight) RightSide [0..1];
  association [0..1] LeftSide (connectedLeftList) <-> (connectedRightList) RightSide [*];
  public class Sides {
    LeftSide left;
  }

  <<singleton>>
  public class AssocCommandCollector {
    // Create a new object & return it
    LeftSide constructNewLeftSide(String leftLabel, String rightLabel);

    // Create a new rightside to the connectedRight
    RightSide addNewRightSideTo(LeftSide leftSide, boolean setAssocInBuilder);
  }

  //public interface MyBetterInterface extends MyInterface {}
  //public class MyBetterInterfaceImpl implements MyBetterInterface {
  //    String name;
  //}

  enum MyEnum {
    A,B,C;
  }

  <<singleton>>
  class TestCommandUpdates {
    CommandTestResult doTestCommand(boolean doBuild);
  }
  class CommandTestResult {
    String field;
  }

  <<singleton>>
  class TestCommandParams {
    String TestCommand_Domain(Animal a);
    String TestCommand_DomainOpt(Optional<Animal> a);
    String TestCommand_DomainListCT(List<Animal> a);
    String TestCommand_DomainListJU(java.util.List<Animal> a);
    String TestCommand_DomainEnum(MyEnum e); // see also https://git.rwth-aachen.de/monticore/monticore/-/work_items/4832
    String TestCommand_DomainEnumListCT(List<MyEnum> e);
    String TestCommand_DomainEnumListJU(java.util.List<MyEnum> e);
    String TestCommand_DomainEnumOpt(Optional<MyEnum> e);
    String TestCommand_Primitive_i(int i);
    String TestCommand_PrimitiveW_i(Integer i);
    //String TestCommand_PrimitiveWList_iCT(List<Integer> i);  // TODO: Only String is supported as a primitive type! (https://git.rwth-aachen.de/monticore/monticore/-/work_items/5256)
    //String TestCommand_PrimitiveWList_iJU(java.util.List<Integer> i); // TODO: Only String is supported as a primitive type! (https://git.rwth-aachen.de/monticore/monticore/-/work_items/5256)
    String TestCommand_PrimitiveWOptional_i(Optional<Integer> i);
    String TestCommand_Primitive2_i(int i, int i2);
    String TestCommand_Primitive_f(float f);
    String TestCommand_String(String s);
    String TestCommand_StringListCT(List<String> s); // TODO: Collection Types broken, as they construct different methods as java.util types (https://git.rwth-aachen.de/monticore/monticore/-/work_items/5257)
    String TestCommand_StringListJU(java.util.List<String> s);
    String TestCommand_StringOpt(Optional<String> s);
  }

  <<singleton>>
  class CounterService {
    int counter = 0;
  }
}
