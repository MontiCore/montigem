package demo;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.editor.MonacoEditor;
import mc.fenix.functiondisplay.FunctionDisplay;
import mc.fenix.input.GemTextInput;

import MontiArcVizExperiment.DemoApp;

page Demo(DemoApp app) {
  @GemRow(height = "100%", width = "100%", components = [
    @GemColumn(width = "50%", height = "100%", components = [
      @GemRow(
        width = "100%",
        hAlign = "space-evenly",
        vAlign = "center",
        components = [
          @GemTextInput(
            labelText = "Main function name:",
            entry = app.mainFunctionNameInput
          ),
          @GemButton(
            label = "Render",
            leftClick = renderSrc()
          )
        ]
      ),
      @MonacoEditor(
        width = "100%",
        height = "100vh", //ensure editor is stretched out over whole remaining page
        entry = app.srcInput,
        language = "MontiArc"
      )
    ]),
    @GemColumn(width = "50%", height = "100%", vAlign = "stretch", components = [
      @FunctionDisplay(data = app.render(app.renderedFunction))
    ])
  ]);
}
