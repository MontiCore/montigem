package demo;

import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemText;
import mc.fenix.editor.MonacoEditor;
import mc.fenix.functiondisplay.FunctionDisplay;
import mc.fenix.input.GemTextInput;

import MontiArcVizExperiment.DemoApp;

page Demo(DemoApp app) {
  demoContainer@GemRow(height = "100%", width = "100%", components = [
    editorSection@GemColumn(width = "50%", height = "100%", components = [
      toolbar@GemRow(
        width = "100%",
        hAlign = "space-evenly",
        vAlign = "center",
        components = [
          functionInput@GemTextInput(
            labelText = "Main function name:",
            entry = app.mainFunctionNameInput
          ),
          renderBtn@GemButton(
            label = "Render",
            leftClick = renderSrc()
          )
        ]
      ),
      editor@MonacoEditor(
        width = "100%",
        height = "100vh", //ensure editor is stretched out over whole remaining page
        entry = app.srcInput,
        language = "MontiArc"
      )
    ]),
    previewSection@GemColumn(width = "50%", height = "100%", vAlign = "top", components = [
      infoCard@GemCard(
        title = "MontiArc Visualization Demo",
        width = "100%",
        component = @GemColumn(rowGap = ".5rem", components = [
          @GemText(value = "The source code of this page demonstrates how to use the MA2FuStruMoTool to visualize a MontiArc component."),
          @GemText(value = "Enter some valid MontiArc code in the editor window on the left, set the qualified path to the component and click the 'render' button. The component will be rendered below."),
          @GemText(value = "You can zoom and pan with your mouse in the resulting view.")
        ])
      ),
      errorsSection@GemColumn(width = "100%", components = [
        @guard(app.renderedFunction.errors != "") {
          errorsCard@GemCard(
            title = "MontiArc errors",
            width = "100%",
            component = errorsText@GemText(value = app.renderedFunction.errors, color = "#cc071e")
          );
        }
      ]),
      diagramDisplay@FunctionDisplay(data = app.render(app.renderedFunction))
    ])
  ]);
}
