package summerschooltutorial;

classdiagram IMMTypes {

  public class Part {
    Mold mold;
    PlasticColor color;
    boolean overheated;
    double weight; // g
    double shrinkage; // %
  }

/* <- Step SERVICE_QUALITY_CONTROL TASK : START -> */
  /* TODO: add the QualityVerdict class here — the DT's per-part quality decision that
     travels back to the machine: the product serial it refers to and the scrap flag
     (true = sort out, false = keep; see the worksheet). */
/* <- Step SERVICE_QUALITY_CONTROL TASK : END -> */
/* <- Step SERVICE_QUALITY_CONTROL SOLUTION : START -> */
  public class QualityVerdict {
    long serial;
    boolean scrap; // true = sort out, false = keep (overrides the machine's default rule)
  }
/* <- Step SERVICE_QUALITY_CONTROL SOLUTION : END -> */

  enum PlasticColor {
    RED,
    GREEN,
    BLUE;
  }

  enum Mold {
    T_REX,
    TRICERATOPS,
    BRACHIOSAURUS,
    PTERODACTYLS;
  }

}
