/* <- Step COCKPIT FILE -> */
/* DT cockpit tags (see AGENTS.md 2.3): keeps the DT concerns out of the functional
 * MontiArc model. ForOverview = card in the overview cockpit;
 * ForOverview = "controls" would additionally generate Start/Stop buttons. */
tags IMMOverview for IMM {
  tag iMM with ForOverview;
/* <- Step COCKPIT TASK : START -> */
  /* TODO: tag the two subcomponents injectionUnit and clampingUnit with
     ForOverview. Use a within block so you do not repeat the root prefix. */
/* <- Step COCKPIT TASK : END -> */
/* <- Step COCKPIT SOLUTION : START -> */
  within iMM {
    tag injectionUnit, clampingUnit with ForOverview;
/* <- Step COCKPIT SOLUTION : END -> */
/* <- Step QUALITY_INSPECTOR TASK : START -> */
    /* Prepared cockpit tag for the new component — activate it by removing this
       surrounding comment once your inspector model compiles:

    tag qualityInspector with ForOverview;
    */
/* <- Step QUALITY_INSPECTOR TASK : END -> */
    tag qualityInspector with ForOverview;  //<- QUALITY_INSPECTOR SOLUTION ->
  }                                         //<- COCKPIT SOLUTION ->
}
